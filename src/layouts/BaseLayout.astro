---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import GoogleConsentManager from '../components/GoogleConsentManager.astro';
import ProvenancePanel from '../components/ProvenancePanel.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { getAdSenseScriptUrl } from '../config/adsense';
import { getLangFromUrl, useTranslations, getHtmlLang, getAlternateLanguages, languages } from '../i18n';
import { getSeoTitle } from '../i18n/seo';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** 关闭面包屑（首页/404 等无层级页面）。 */
  breadcrumb?: boolean;
  /** 覆盖面包屑末段文案（标题过长时用）。 */
  breadcrumbLabel?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const htmlLang = getHtmlLang(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const alternates = getAlternateLanguages(Astro.url.pathname, base);

const {
  title,
  description = t('site.description'),
  ogImage,
  noindex = false,
  breadcrumb = true,
  breadcrumbLabel,
} = Astro.props;

const siteName = t('site.title');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const pathSegments = Astro.url.pathname.replace(base, '').split('/').filter(Boolean);
if (pathSegments[0] && pathSegments[0] in languages) pathSegments.shift();
const contentSection = pathSegments[0];
const fullTitle = getSeoTitle(lang, Astro.url.pathname, title);
const readingSections = new Set(['mechanics', 'database', 'guides', 'strategies', 'changelog']);
const isReadingPage = contentSection !== undefined && readingSections.has(contentSection) && pathSegments.length > 1;
const googleCmpEnabled = import.meta.env.PUBLIC_GOOGLE_CMP_ENABLED === 'true';
const adSenseScriptSrc = getAdSenseScriptUrl();
const provenanceSources = contentSection === 'database'
  ? [
      { label: 'Config.ts', path: 'src/core/configuration/Config.ts' },
      { label: 'Game.ts', path: 'src/core/game/Game.ts' },
      { label: 'Map resources', path: 'resources/maps' },
    ]
  : contentSection === 'mechanics'
    ? [
        { label: 'Config.ts', path: 'src/core/configuration/Config.ts' },
        { label: 'Game source', path: 'src/core/game' },
      ]
    : [];
---

<!doctype html>
<html lang={htmlLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {alternates.map(({ lang: altLang, href }) => (
      <link rel="alternate" hreflang={getHtmlLang(altLang)} href={new URL(href, Astro.site ?? Astro.url).toString()} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.find(a => a.lang === 'en')?.href ?? '/', Astro.site ?? Astro.url).toString()} />

    <GoogleConsentManager enabled={googleCmpEnabled} />
    <script is:inline async src={adSenseScriptSrc} crossorigin="anonymous"></script>

    <!-- Google Analytics is loaded only after explicit consent. -->
    <script is:inline>
      (() => {
        const STORAGE_KEY = 'openfront-intel-consent-v1';
        const GA_ID = 'G-7R6FVF17YG';

        const loadAnalytics = () => {
          if (document.querySelector('script[data-openfront-analytics]')) return;
          window[`ga-disable-${GA_ID}`] = false;
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function gtag(){ window.dataLayer.push(arguments); };
          window.gtag('consent', 'default', {
            analytics_storage: 'granted',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
          window.gtag('js', new Date());
          window.gtag('config', GA_ID, { anonymize_ip: true });

          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          script.dataset.openfrontAnalytics = 'true';
          document.head.appendChild(script);
        };

        const disableAnalytics = () => {
          window[`ga-disable-${GA_ID}`] = true;
          window.gtag?.('consent', 'update', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
          document.querySelectorAll('script[data-openfront-analytics]').forEach((script) => script.remove());
        };

        try {
          if (window.localStorage.getItem(STORAGE_KEY) === 'analytics') loadAnalytics();
        } catch {
          // Analytics remains disabled when storage is unavailable.
        }

        window.addEventListener('openfront:analytics-consent', loadAnalytics);
        window.addEventListener('openfront:analytics-consent-revoked', disableAnalytics);
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="flex flex-col">
    {isReadingPage && <ReadingProgress />}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-cannon-600 focus:px-3 focus:py-2 focus:text-sm focus:text-iron-950">{t('a11y.skipToMain')}</a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      {breadcrumb && <Breadcrumb title={title} label={breadcrumbLabel} />}
      <slot />
      {(contentSection === 'database' || contentSection === 'mechanics') && (
        <div class="container-wide pb-4">
          <ProvenancePanel
            kind={contentSection === 'database' ? 'data' : 'mechanics'}
            sources={provenanceSources}
          />
        </div>
      )}
    </main>
    <Footer lang={lang} />
    <ConsentBanner lang={lang} />
  </body>
</html>
