---
import { useTranslations, type Lang } from '../i18n';
import { feedbackIntegration } from '../config/feedback';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const langPrefix = lang === 'en' ? '' : `/${lang}`;

const links: Array<{ href: string; label: string; external?: boolean }> = [
  { href: `${base}${langPrefix}/mechanics/`, label: t('nav.mechanics') },
  { href: `${base}${langPrefix}/database/`, label: t('nav.database') },
  { href: `${base}${langPrefix}/strategies/`, label: t('nav.strategies') },
  { href: `${base}${langPrefix}/guides/`, label: t('nav.guides') },
  { href: `${base}${langPrefix}/whats-new/`, label: t('nav.whatsNew') },
  { href: `${base}${langPrefix}/glossary/`, label: t('nav.glossary') },
  { href: `${base}${langPrefix}/shortcuts/`, label: t('nav.shortcuts') },
  {
    href: feedbackIntegration.feedbackUrl,
    label: t('nav.feedback'),
    external: true,
  },
];

function isActive(href: string) {
  const trimmed = href.replace(/\/$/, '');
  if (trimmed === base) return pathname === base + '/' || pathname === base;
  return pathname.startsWith(trimmed);
}
---

<nav aria-label={t('nav.aria')}>
  <ul class="grid grid-cols-1 gap-1 text-sm sm:grid-cols-2 lg:flex lg:items-center lg:gap-5">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          data-feedback-provider={link.external ? feedbackIntegration.provider : undefined}
          class:list={[
            'nav-link',
            'nav-link-responsive',
            isActive(link.href) ? 'active' : '',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
          {link.external && <span class="ml-1 text-xs" aria-hidden="true">↗</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>
