---
import { getLangFromUrl, stripLangPrefix, type Lang } from '../i18n';
const lang = getLangFromUrl(Astro.url);
const base = import.meta.env.BASE_URL;
const prefix = `${base}${lang === 'en' ? '' : `${lang}/`}`;
const path = stripLangPrefix(Astro.url.pathname.slice(base.length)).replace(/\/$/, '');
type Topic = 'playback' | 'review' | 'maps' | 'mirv';
type Answer = { title: string; steps: string[]; links: [string, string][] };
const topics: Record<string, Topic> = { 'guides/seekable-replay-viewer': 'playback', 'guides/replay-review': 'review', 'guides/map-size-compact-mode': 'maps', 'guides/mirv': 'mirv' };
const copy: Record<Lang, Record<Topic, Answer>> = {
  en: {
    playback: { title: 'Find a replay and start watching', steps: ['Open a player profile, choose Games, then open a finished match. Keep its game link so you can return.', 'For the seekable timeline, enable New Replay Viewer in Settings. If the timeline is still processing, wait for the part you want to watch; older builds may open their own replay page.', 'Pause at the decision you want to inspect. Playback shows what happened; the review guide helps you turn it into one change for your next match.'], links: [['guides/replay-review/', 'How to learn from this replay']] },
    review: { title: 'Already have a replay? Review one decision', steps: ['First get the match open. If you need the history, playback or timeline controls, use the replay viewer guide below.', 'Choose one turning point: what did you know, what did you do, and which signal first contradicted your plan?', 'Write one action to try next game, with a trigger and a stop condition. A final score alone cannot tell you why a decision failed.'], links: [['guides/seekable-replay-viewer/', 'Find and play a match replay']] },
    maps: { title: 'Largest grid or most playable land?', steps: ['Compare total grid cells for map dimensions; compare playable land for territory you can actually occupy. Water and blocked background make these different rankings.', 'Compact loads a smaller game grid, not a camera zoom. Check the lobby setting before choosing your spawn or judging distances.', 'Use the map database for the available map list and this guide for the dated size comparison and Compact rules.'], links: [['database/maps/', 'Compare the map database'], ['maps/', 'Find a map opening guide']] },
    mirv: { title: 'MIRV: what happens after launch?', steps: ['Silo → carrier → separated warheads → impact. The carrier spreads a nuclear strike across the selected player’s territory.', 'SAM cannot target the carrier. After separation, individual warheads can be intercepted: do not treat the whole strike as immune.', 'Before buying, check the current cost and the defender’s ready coverage. Target shape and interception mean the number of warheads is not a guaranteed number of hits.'], links: [['guides/mirv-price-ladder/', 'Check the MIRV price ladder'], ['guides/crown-position-mirv-defense/', 'Plan MIRV defense']] },
  },
  zh: {
    playback: { title: '找到录像，开始回放', steps: ['打开玩家资料，在 Games／游戏历史中选择已结束的对局。保留对局链接，方便再次打开。', '需要可跳转时间轴时，在设置中启用 New Replay Viewer／新录像查看器。时间轴仍在处理时，先等待目标片段可用；旧版本对局可能打开对应版本的回放页面。', '暂停在要检查的决策处。播放器帮助你看清发生了什么，复盘指南帮助你把观察变成下一局的一个改进。'], links: [['guides/replay-review/', '学习如何复盘这场对局']] },
    review: { title: '已经打开录像？只复盘一个决策', steps: ['先打开对局。寻找历史、回放入口或时间轴操作，请看下方录像查看器指南。', '选一个转折点：当时知道什么、做了什么、哪个信号最先推翻原计划？', '为下一局写一个动作，并明确何时执行、何时停止。最终分数本身不能解释某次决策为什么失败。'], links: [['guides/seekable-replay-viewer/', '找到并播放对局录像']] },
    maps: { title: '最大网格，还是最多可用陆地？', steps: ['比较地图尺寸看总网格；比较能占领多少领土看可用陆地。水面与不可通行背景会让两种排名不同。', 'Compact 加载更小的游戏网格，不是镜头缩放。选出生点、判断距离前先看大厅设置。', '地图数据库列出本站收录地图；本文解释指定版本的尺寸对比和 Compact 规则。'], links: [['database/maps/', '对比地图数据库'], ['maps/', '寻找单图开局攻略']] },
    mirv: { title: 'MIRV 发射后会发生什么？', steps: ['发射井 → 载体 → 分离弹头 → 命中。载体把核打击分散到所选玩家的领土。', 'SAM 不能拦截载体；分离后的每个弹头可以被单独拦截，因此整次打击并非免疫防空。', '购买前检查当前价格和对方已就绪的防空覆盖。目标形状与拦截会影响结果，弹头数量不等于保证命中数量。'], links: [['guides/mirv-price-ladder/', '查看 MIRV 价格阶梯'], ['guides/crown-position-mirv-defense/', '规划 MIRV 防御']] },
  },
  fr: {
    playback: { title: 'Trouver un replay et le lancer', steps: ['Ouvrez le profil d’un joueur, puis Games et une partie terminée. Gardez le lien de la partie pour y revenir.', 'Pour la chronologie navigable, activez New Replay Viewer dans les paramètres. Si le traitement continue, attendez le passage voulu ; une ancienne version peut ouvrir sa propre page de replay.', 'Mettez en pause au moment de la décision. Le lecteur montre les événements ; le guide de débriefing aide à choisir un changement pour la partie suivante.'], links: [['guides/replay-review/', 'Tirer une leçon de ce replay']] },
    review: { title: 'Replay ouvert ? Analysez une seule décision', steps: ['Ouvrez d’abord la partie. Pour l’historique, la lecture ou la chronologie, consultez le guide du lecteur ci-dessous.', 'Choisissez un tournant : que saviez-vous, qu’avez-vous fait et quel signe a contredit votre plan en premier ?', 'Notez une action pour la prochaine partie, avec un déclencheur et une limite. Le score final ne suffit pas à expliquer un échec.'], links: [['guides/seekable-replay-viewer/', 'Trouver et lire un replay']] },
    maps: { title: 'Plus grande grille ou plus de terres jouables ?', steps: ['Comparez les cellules totales pour les dimensions, les terres jouables pour le territoire occupable. Eau et zones bloquées changent le classement.', 'Compact charge une grille de jeu plus petite : ce n’est pas un zoom. Vérifiez le réglage du salon avant de choisir votre départ ou d’estimer les distances.', 'La base de cartes fournit la liste disponible ; ce guide explique la comparaison datée des tailles et les règles Compact.'], links: [['database/maps/', 'Comparer la base de cartes'], ['maps/', 'Choisir une ouverture par carte']] },
    mirv: { title: 'MIRV : que se passe-t-il après le lancement ?', steps: ['Silo → porteur → ogives séparées → impact. Le porteur répartit la frappe nucléaire sur le territoire du joueur ciblé.', 'Les SAM ne ciblent pas le porteur. Après séparation, chaque ogive peut être interceptée : toute la frappe n’est donc pas immunisée.', 'Avant l’achat, vérifiez le prix actuel et la défense prête à tirer. Forme du territoire et interceptions empêchent de garantir autant d’impacts que d’ogives.'], links: [['guides/mirv-price-ladder/', 'Voir la hausse du prix MIRV'], ['guides/crown-position-mirv-defense/', 'Préparer la défense MIRV']] },
  },
  de: {
    playback: { title: 'Replay finden und ansehen', steps: ['Öffne ein Spielerprofil, dann Games und eine beendete Partie. Bewahre den Spiellink auf.', 'Aktiviere für die springbare Zeitleiste New Replay Viewer in den Einstellungen. Warte bei laufender Verarbeitung auf den gewünschten Abschnitt; ältere Versionen können ihre eigene Replay-Seite öffnen.', 'Pausiere an der Entscheidung, die du prüfen willst. Der Player zeigt den Ablauf; die Auswertung hilft dir, eine Änderung für die nächste Partie abzuleiten.'], links: [['guides/replay-review/', 'Aus diesem Replay lernen']] },
    review: { title: 'Replay offen? Eine Entscheidung auswerten', steps: ['Öffne zuerst die Partie. Verlauf, Wiedergabe und Zeitleiste erklärt die Anleitung zum Replay-Player unten.', 'Wähle einen Wendepunkt: Was wusstest du, was hast du getan und welches Signal widerlegte zuerst deinen Plan?', 'Notiere eine Aktion für die nächste Partie mit Auslöser und Abbruchbedingung. Der Endstand allein erklärt keine Fehlentscheidung.'], links: [['guides/seekable-replay-viewer/', 'Ein Replay finden und abspielen']] },
    maps: { title: 'Größtes Raster oder meiste spielbare Landfläche?', steps: ['Vergleiche alle Rasterzellen für die Kartengröße und spielbares Land für besetzbares Gebiet. Wasser und gesperrter Hintergrund verändern die Rangfolge.', 'Compact lädt ein kleineres Spielraster und ist kein Kamera-Zoom. Prüfe die Lobby-Einstellung vor Startplatzwahl und Entfernungsschätzungen.', 'Die Kartendatenbank listet verfügbare Karten. Diese Anleitung erklärt den datierten Größenvergleich und die Compact-Regeln.'], links: [['database/maps/', 'Kartendatenbank vergleichen'], ['maps/', 'Einstieg für eine Karte finden']] },
    mirv: { title: 'MIRV: Was geschieht nach dem Start?', steps: ['Silo → Träger → getrennte Sprengköpfe → Einschlag. Der Träger verteilt einen Atomangriff über das Gebiet des gewählten Spielers.', 'SAM kann den Träger nicht anvisieren. Getrennte Sprengköpfe lassen sich einzeln abfangen; der gesamte Angriff ist nicht immun.', 'Prüfe vor dem Kauf den aktuellen Preis und die schussbereite Abwehr. Gebietsform und Abfangen bedeuten, dass Sprengköpfe keine garantierten Treffer sind.'], links: [['guides/mirv-price-ladder/', 'MIRV-Preisstufen prüfen'], ['guides/crown-position-mirv-defense/', 'MIRV-Abwehr planen']] },
  },
  nl: {
    playback: { title: 'Een replay vinden en afspelen', steps: ['Open een spelersprofiel, kies Games en open een afgelopen wedstrijd. Bewaar de wedstrijdlink om terug te keren.', 'Schakel voor de tijdlijn New Replay Viewer in bij de instellingen. Wacht bij lopende verwerking tot het gewenste deel klaar is; oudere versies kunnen hun eigen replaypagina openen.', 'Pauzeer bij de beslissing die je wilt bekijken. De speler toont wat er gebeurde; de evaluatiegids helpt je één wijziging voor de volgende wedstrijd te kiezen.'], links: [['guides/replay-review/', 'Leren van deze replay']] },
    review: { title: 'Replay geopend? Beoordeel één beslissing', steps: ['Open eerst de wedstrijd. Voor geschiedenis, afspelen en de tijdlijn gebruik je de replaygids hieronder.', 'Kies een keerpunt: wat wist je, wat deed je en welk signaal sprak je plan als eerste tegen?', 'Schrijf één actie voor de volgende wedstrijd op, met een aanleiding en stopvoorwaarde. Alleen de eindscore verklaart geen verkeerde beslissing.'], links: [['guides/seekable-replay-viewer/', 'Een wedstrijdreplay vinden en afspelen']] },
    maps: { title: 'Grootste raster of meeste speelbare land?', steps: ['Vergelijk alle rastercellen voor de kaartafmetingen en speelbaar land voor gebied dat je kunt bezetten. Water en geblokkeerde achtergrond geven verschillende ranglijsten.', 'Compact laadt een kleiner spelraster en is geen camerazoom. Controleer de lobbyinstelling voordat je een startplek kiest of afstanden inschat.', 'De kaartendatabase toont de beschikbare kaarten; deze gids legt de gedateerde groottevergelijking en Compact-regels uit.'], links: [['database/maps/', 'Kaartendatabase vergelijken'], ['maps/', 'Een opening per kaart vinden']] },
    mirv: { title: 'MIRV: wat gebeurt er na de lancering?', steps: ['Silo → drager → losse kernkoppen → inslag. De drager verspreidt een nucleaire aanval over het gebied van de gekozen speler.', 'SAM kan de drager niet aanvallen. Na scheiding zijn kernkoppen afzonderlijk te onderscheppen; de hele aanval is dus niet immuun.', 'Controleer voor aankoop de huidige prijs en de schietklare verdediging. Gebiedsvorm en onderschepping maken het aantal kernkoppen geen garantie voor treffers.'], links: [['guides/mirv-price-ladder/', 'De MIRV-prijsladder bekijken'], ['guides/crown-position-mirv-defense/', 'MIRV-verdediging plannen']] },
  },
};
const topic = topics[path];
const answer = topic ? copy[lang][topic] : null;
---
{answer && <section class="my-6 rounded-xl border border-cannon-700 bg-iron-900/70 p-5" aria-labelledby="longtail-answer-title" data-longtail-answer={topic}>
  <h2 id="longtail-answer-title" class="text-xl font-bold text-iron-100">{answer.title}</h2>
  <ol class="mt-4 list-decimal space-y-3 pl-5 text-sm leading-relaxed text-iron-200">{answer.steps.map(step => <li>{step}</li>)}</ol>
  <nav class="mt-4 flex flex-wrap gap-x-5 gap-y-3 text-sm" aria-label={answer.title}>{answer.links.map(([href, label]) => <a class="underline text-cannon-400" href={`${prefix}${href}`}>{label}</a>)}</nav>
</section>}
