---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import { byLang, getIntlLocale, stripLangPrefix, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const langPrefix = lang === 'en' ? '' : `${lang}/`;
const entries = (await getCollection('changelog'))
  .filter(byLang(lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const locale = getIntlLocale(lang);
const formatDate = (date: Date) => new Intl.DateTimeFormat(locale, { dateStyle: 'medium' }).format(date);
const groups = [
  { status: 'not-released' as const, title: t('whatsNew.group.notReleased') },
  { status: 'released' as const, title: t('whatsNew.group.released') },
];

function articleHref(slug: string) {
  return `${base}${langPrefix}changelog/${stripLangPrefix(slug)}/`;
}

function statusLabel(status: 'released' | 'not-released') {
  return status === 'not-released' ? t('whatsNew.status.not-released') : t('whatsNew.status.released');
}
---

<BaseLayout title={t('whatsNew.title')} description={t('whatsNew.lead')}>
  <div data-whats-new-page>
    <PageHeader eyebrow={t('whatsNew.eyebrow')} title={t('whatsNew.title')} lead={t('whatsNew.lead')} />
    <section class="container-wide py-10" aria-label={t('whatsNew.eyebrow')}>
      <div class="space-y-12">
        {groups.map((group) => {
          const groupEntries = entries.filter((entry) => entry.data.releaseStatus === group.status);
          if (groupEntries.length === 0) return null;
          return (
            <section data-whats-new-group={group.status} aria-labelledby={`whats-new-${group.status}`}>
              <div class="flex flex-wrap items-end justify-between gap-3 border-b border-iron-800 pb-3">
                <h2 id={`whats-new-${group.status}`} class="text-xl font-semibold text-iron-50">{group.title}</h2>
                <span class="text-xs text-iron-500">{groupEntries.length}</span>
              </div>
              <ul class="mt-5 grid gap-4 lg:grid-cols-2">
                {groupEntries.map((entry) => (
                  <li>
                    <article class="flex h-full flex-col rounded-lg border border-iron-800 bg-iron-900/40 p-5" data-whats-new-article={entry.data.version}>
                      <div class="flex flex-wrap items-center gap-2 text-xs">
                        <span class="rounded px-2 py-1 font-medium" data-whats-new-status={group.status}>{statusLabel(group.status)}</span>
                        <span class="tag-chip">{entry.data.version}</span>
                        <span class="text-iron-500">{formatDate(entry.data.pubDate)}</span>
                      </div>
                      <h3 class="mt-4 text-lg font-semibold leading-snug text-iron-100">{entry.data.title}</h3>
                      <p class="mt-3 flex-1 text-sm leading-relaxed text-iron-300">{entry.data.description}</p>
                      <a class="mt-5 text-sm text-cannon-400 hover:underline" href={articleHref(entry.slug)}>{t('whatsNew.article.read')} →</a>
                    </article>
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
      <p class="mt-12 border-t border-iron-800 pt-5 text-sm text-iron-400">
        {t('whatsNew.boundary')}
        <a class="ml-1 text-cannon-400 hover:underline" href={`${base}${langPrefix}changelog/`}>{t('whatsNew.fullHistory')}</a>
      </p>
    </section>
  </div>
</BaseLayout>
