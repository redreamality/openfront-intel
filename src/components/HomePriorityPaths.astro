const paths: Record<PriorityId, string> = {
  latest: 'changelog/v33/',
  'first-match': 'guides/first-match/',
  shortcuts: 'shortcuts/',
  economy: 'mechanics/economy/',
};

const { lang } = Astro.props as Props;
const copy = copyByLang[lang];
const base = import.meta.env.BASE_URL;
const langPrefix = lang === 'en' ? '' : `${lang}/`;
---

<section class="border-b border-iron-800 bg-iron-950/30" data-home-priority aria-labelledby="home-priority-title">
  <div class="container-wide py-12 sm:py-16">
    <p class="tag-chip">{copy.eyebrow}</p>
    <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.65fr)] lg:items-end">
      <h2 id="home-priority-title" class="max-w-3xl text-2xl font-semibold tracking-tight text-iron-50 sm:text-3xl">{copy.title}</h2>
      <p class="text-sm leading-relaxed text-iron-400 sm:text-base">{copy.lead}</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {copy.cards.map((card, index) => (
        <a
          href={`${base}${langPrefix}${paths[card.id]}`}
          class:list={[
            'group flex h-full flex-col rounded-lg border p-5 transition-colors',
            card.id === 'latest'
              ? 'border-cannon-700 bg-cannon-950/20 hover:border-cannon-500'
              : 'border-iron-800 bg-iron-900/40 hover:border-military-600',
          ]}
          data-home-priority-link
          data-priority-id={card.id}
        >
          <div class="flex items-center justify-between gap-3 text-xs uppercase tracking-widest">
            <span class={card.id === 'latest' ? 'text-cannon-400' : 'text-military-300'}>{card.eyebrow}</span>
            <span class="font-mono text-iron-600">0{index + 1}</span>
          </div>
          <h3 class="mt-4 text-lg font-semibold leading-snug text-iron-100 group-hover:text-cannon-300">{card.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-iron-400">{card.description}</p>
          <span class="mt-5 text-xs font-medium text-iron-300 group-hover:text-cannon-400">{card.cta} →</span>
        </a>
      ))}
    </div>
  </div>
</section>
