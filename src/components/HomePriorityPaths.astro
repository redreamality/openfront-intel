---
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

type PriorityId = 'latest' | 'first-match' | 'shortcuts' | 'economy';

interface PriorityCard {
  id: PriorityId;
  eyebrow: string;
  title: string;
  description: string;
  cta: string;
}

interface PriorityCopy {
  eyebrow: string;
  title: string;
  lead: string;
  cards: PriorityCard[];
}

