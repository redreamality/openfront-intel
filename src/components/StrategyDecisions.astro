---
import { getLangFromUrl } from '../i18n';
import { latestOpenFrontRelease } from '../config/openfront-release';
const lang = getLangFromUrl(Astro.url);
const prefix = `${import.meta.env.BASE_URL}${lang === 'en' ? '' : `${lang}/`}`;
const copy = {
  en: { title: 'Choose your next move', version: 'Current strategy', summary: 'The first few port or factory levels get a spawn boost in v35. That helps a small economy restart; it does not replace a safe route or make isolated buildings profitable.', labels: ['Your position', 'Do this next', 'Stop or change course when'], rows: [ ['Opening', 'Take nearby neutral land, keep troops in reserve, then establish one working income route.', 'Your next border cannot be defended with the troops left at home.'], ['Behind', 'Protect the income you still have. Repair one useful trade route before buying a larger network.', 'A new building would use the reserve needed to survive the next attack.'], ['Leading', 'Keep your borders compact and watch several neighbors together; stronger nations can pressure a runaway FFA leader.', 'Another expansion exposes a coast or an undefended connection.'], ['Endgame', 'Read the actual victory rule and choose a territory objective you can hold through the next counterattack.', 'A costly strike changes the map but gives you no defensible route to victory.'] ], links: ['Play your first match', 'Recover a small economy', 'Handle the FFA leader', 'Plan the endgame'], changes: 'What changed in this version?' },
  zh: { title: '按当前局势选择下一步', version: '当前版本策略', summary: 'v35 会加快少量港口或工厂等级的出船、出车节奏，有助于小经济重新起步；安全路线仍然必要，孤立建筑不会因此赚钱。', labels: ['当前局势', '下一步行动', '何时停止或调整'], rows: [ ['开局', '先取附近中立地，留住预备兵力，再建立一条真正能结算的收入路线。', '下一段边界已经超出留守兵力的防守能力。'], ['落后', '保护剩余收入，先修复一条有用的贸易路线，再扩大网络。', '新建筑会花掉抵御下一轮进攻所需的储备。'], ['领先', '保持紧凑边界，同时观察多个邻居；较强国家可能共同压制 FFA 中失控的领先者。', '继续扩张会暴露海岸或无人防守的连接地带。'], ['终局', '读取本局实际胜利规则，选择能撑过下一轮反击的领土目标。', '昂贵打击虽然改变地图，却没有带来可防守的获胜路线。'] ], links: ['完成第一场对局', '恢复小规模经济', '处理 FFA 头名', '规划终局'], changes: '这个版本改变了什么？' },
  fr: { title: 'Choisir votre prochaine action', version: 'Stratégie actuelle', summary: 'En v35, les premiers niveaux de ports ou d’usines font partir les unités commerciales plus vite. Ce bonus aide une petite économie à repartir ; il ne remplace ni une route sûre ni une destination rentable.', labels: ['Votre situation', 'Action suivante', 'Arrêtez ou adaptez si'], rows: [ ['Début de partie', 'Prenez le terrain neutre proche, gardez une réserve, puis ouvrez une route qui rapporte réellement.', 'La prochaine frontière dépasse ce que vos troupes restantes peuvent défendre.'], ['Vous êtes derrière', 'Protégez vos revenus restants. Rétablissez une route utile avant d’agrandir le réseau.', 'Un bâtiment consommerait la réserve nécessaire pour résister à la prochaine attaque.'], ['Vous êtes en tête', 'Gardez des frontières compactes et surveillez plusieurs voisins ; les nations plus fortes peuvent freiner le leader en FFA.', 'L’expansion expose une côte ou une liaison non défendue.'], ['Fin de partie', 'Lisez la condition de victoire de ce salon et choisissez un objectif territorial que vous pourrez conserver.', 'Une frappe coûteuse modifie la carte sans ouvrir de voie défendable vers la victoire.'] ], links: ['Jouer votre première partie', 'Relancer une petite économie', 'Réagir au leader en FFA', 'Préparer la fin de partie'], changes: 'Qu’est-ce qui a changé ?' },
  de: { title: 'Wähle deinen nächsten Schritt', version: 'Aktuelle Strategie', summary: 'In v35 starten die ersten Hafen- oder Fabrikstufen Handelseinheiten schneller. Das hilft kleinen Wirtschaften beim Neustart; sichere Routen und lohnende Ziele bleiben erforderlich.', labels: ['Deine Lage', 'Nächste Aktion', 'Stoppen oder umplanen, wenn'], rows: [ ['Spielbeginn', 'Nimm nahes neutrales Land, halte eine Reserve und richte dann eine funktionierende Einnahmeroute ein.', 'Die nächste Grenze mehr Truppen braucht, als zu Hause bleiben.'], ['Im Rückstand', 'Schütze verbleibende Einnahmen. Repariere eine nützliche Handelsroute, bevor du das Netz vergrößerst.', 'Ein Gebäude die Reserve für den nächsten Angriff verbrauchen würde.'], ['In Führung', 'Halte Grenzen kompakt und beobachte mehrere Nachbarn; stärkere Nationen können den führenden FFA-Spieler gemeinsam unter Druck setzen.', 'Weitere Expansion eine Küste oder eine ungeschützte Verbindung öffnet.'], ['Endspiel', 'Prüfe die tatsächliche Siegbedingung und wähle ein Gebietsziel, das du gegen den nächsten Gegenangriff halten kannst.', 'Ein teurer Angriff die Karte verändert, aber keinen haltbaren Weg zum Sieg schafft.'] ], links: ['Die erste Partie spielen', 'Eine kleine Wirtschaft erholen', 'Den FFA-Spitzenreiter bremsen', 'Das Endspiel planen'], changes: 'Was hat sich geändert?' },
  nl: { title: 'Kies je volgende stap', version: 'Huidige strategie', summary: 'In v35 laten de eerste haven- of fabrieksniveaus sneller handelseenheden vertrekken. Dat helpt een kleine economie herstellen; een veilige route en een betalende bestemming blijven nodig.', labels: ['Je situatie', 'Doe dit hierna', 'Stop of pas aan wanneer'], rows: [ ['Opening', 'Neem nabij neutraal land, houd troepen achter en bouw daarna één werkende inkomstenroute.', 'Je volgende grens meer verdedigers nodig heeft dan je thuis overhoudt.'], ['Achterstand', 'Bescherm de inkomsten die je nog hebt. Herstel één nuttige handelsroute voordat je het netwerk uitbreidt.', 'Een gebouw de reserve zou kosten die je voor de volgende aanval nodig hebt.'], ['Voorsprong', 'Houd grenzen compact en volg meerdere buren; sterkere naties kunnen samen druk zetten op een weglopende FFA-leider.', 'Uitbreiden een kust of onbeschermde verbinding blootlegt.'], ['Eindspel', 'Lees de echte overwinningsregel en kies gebied dat je na de volgende tegenaanval kunt behouden.', 'Een dure aanval de kaart verandert zonder een verdedigbare weg naar de overwinning te openen.'] ], links: ['Speel je eerste partij', 'Herstel een kleine economie', 'Pak de FFA-leider aan', 'Plan het eindspel'], changes: 'Wat is er veranderd?' },
}[lang];
const paths = ['first-match', 'frontload-port-factory-investment', 'ffa-runaway-leader', 'ffa-endgame-commit'];
---
<section class="container-wide py-6" aria-labelledby="strategy-decisions-title" data-strategy-decisions>
  <p class="text-sm font-mono text-cannon-400">{copy.version} · {latestOpenFrontRelease.displayVersion}</p>
  <h2 id="strategy-decisions-title" class="mt-2 text-2xl font-semibold">{copy.title}</h2>
  <p class="mt-3 max-w-4xl leading-relaxed text-iron-300">{copy.summary}</p>
  <div class="mt-5 grid gap-4 md:grid-cols-2">
    {copy.rows.map((row, index) => <article class="card" data-strategy-situation={index}>
      <h3 class="text-lg font-semibold text-cannon-400">{row[0]}</h3>
      <p class="mt-3 text-iron-200"><strong>{copy.labels[1]}: </strong>{row[1]}</p>
      <p class="mt-3 text-sm text-iron-400"><strong>{copy.labels[2]}: </strong>{row[2]}</p>
      <a class="mt-4 inline-block text-cannon-400 underline" href={`${prefix}guides/${paths[index]}/`}>{copy.links[index]}</a>
    </article>)}
  </div>
  <a class="mt-5 inline-block text-sm text-cannon-400 underline" href={`${prefix}changelog/${latestOpenFrontRelease.series}/`}>{copy.changes}</a>
</section>
