---
import { getLangFromUrl, type Lang } from '../i18n';
const lang = getLangFromUrl(Astro.url);
const copy: Record<Lang, { title: string; body: string; link: string }> = {
  en: { title: 'Looking for player stats or match history?', body: 'These tables explain units, buildings and maps. OFstats is a separate, unofficial community tool for searching players, clans and public games.', link: 'Find a player or game on OFstats' },
  fr: { title: 'Vous cherchez des statistiques de joueur ou des parties ?', body: 'Ces tableaux décrivent les unités, bâtiments et cartes. OFstats est un outil communautaire indépendant et non officiel pour rechercher joueurs, clans et parties publiques.', link: 'Trouver un joueur ou une partie sur OFstats' },
  de: { title: 'Suchst du Spielerstatistiken oder frühere Partien?', body: 'Diese Tabellen erklären Einheiten, Gebäude und Karten. OFstats ist ein separates, inoffizielles Community-Werkzeug zur Suche nach Spielern, Clans und öffentlichen Partien.', link: 'Spieler oder Partie auf OFstats finden' },
  nl: { title: 'Zoek je spelersstatistieken of eerdere partijen?', body: 'Deze tabellen beschrijven eenheden, gebouwen en kaarten. OFstats is een apart, onofficieel communityhulpmiddel om spelers, clans en openbare partijen te zoeken.', link: 'Een speler of partij zoeken op OFstats' },
  zh: { title: '想查玩家战绩或对局历史？', body: '这里的表格用于查单位、建筑和地图数据。OFstats 是独立的非官方社区工具，可搜索玩家、战队与公开对局。', link: '去 OFstats 查找玩家或对局' },
};
const content = copy[lang];
---
<aside class="container-wide pt-6" data-player-stats-route>
  <div class="rounded-lg border border-iron-700 bg-iron-900/60 p-5">
    <h2 class="text-lg font-semibold text-iron-50">{content.title}</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">{content.body}</p>
    <a class="mt-3 inline-block font-semibold text-cannon-400 underline hover:text-cannon-300" href="https://ofstats.io/">{content.link} <span aria-hidden="true">↗</span></a>
  </div>
</aside>
