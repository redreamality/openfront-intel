---

<section class="not-prose my-10 overflow-hidden rounded-lg border border-iron-700 bg-iron-900/50" data-nuke-calculator data-locale={lang}>
  <header class="border-b border-iron-700 px-4 py-5 sm:px-6">
    <p class="font-mono text-xs uppercase text-cannon-400">{t.eyebrow}</p>
    <h2 class="mt-1 text-xl font-semibold text-iron-50 sm:text-2xl">{t.title}</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">{t.intro}</p>
  </header>

  <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.9fr)]">
    <div class="divide-y divide-iron-800 lg:border-r lg:border-iron-700">
      <fieldset class="grid gap-4 p-4 sm:grid-cols-2 sm:p-6">
        <legend class="col-span-full mb-1 text-sm font-semibold text-military-200">{t.budget}</legend>
        <label class="grid gap-1.5 text-sm text-iron-200 sm:col-span-2">
          <span>{t.gold}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="gold" min="0" max="999999999999" step="250000" value="200000000" data-testid="nuke-gold" />
        </label>
        <label class="grid gap-1.5 text-sm text-iron-200 sm:col-span-2">
          <span>{t.globalMirvs}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="globalMirvs" min="0" max="1000" step="1" value="0" data-testid="nuke-global-mirvs" />
        </label>
        <label class="grid gap-1.5 text-sm text-iron-200">
          <span>{t.atoms}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="atoms" min="0" max="999" step="1" value="2" data-testid="nuke-atoms" />
        </label>
        <label class="grid gap-1.5 text-sm text-iron-200">
          <span>{t.hydrogens}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="hydrogens" min="0" max="999" step="1" value="1" data-testid="nuke-hydrogens" />
        </label>
        <label class="grid gap-1.5 text-sm text-iron-200 sm:col-span-2">
          <span>{t.mirvs}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="mirvs" min="0" max="100" step="1" value="3" data-testid="nuke-mirvs" />
        </label>
      </fieldset>

      <fieldset class="grid gap-4 p-4 sm:grid-cols-2 sm:p-6">
        <legend class="col-span-full mb-1 text-sm font-semibold text-military-200">{t.launchers}</legend>
        <label class="grid gap-1.5 text-sm text-iron-200">
          <span>{t.siloLevel}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="siloLevel" min="1" max="100" step="1" value="5" data-testid="nuke-silo-level" />
        </label>
        <label class="grid gap-1.5 text-sm text-iron-200">
          <span>{t.siloUsed}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="siloUsed" min="0" max="100" step="1" value="2" data-testid="nuke-silo-used" />
        </label>
        <label class="grid gap-1.5 text-sm text-iron-200">
          <span>{t.samLevel}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="samLevel" min="1" max="100" step="1" value="5" data-testid="nuke-sam-level" />
        </label>
        <label class="grid gap-1.5 text-sm text-iron-200">
          <span>{t.samUsed}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="samUsed" min="0" max="100" step="1" value="2" data-testid="nuke-sam-used" />
        </label>
        <label class="grid gap-1.5 text-sm text-iron-200 sm:col-span-2">
          <span>{t.incoming}</span>
          <input class="min-h-11 w-full rounded border border-iron-600 bg-iron-950 px-3 text-iron-50 focus:border-cannon-400 focus:outline-none" type="number" name="incoming" min="0" max="10000" step="1" value="5" data-testid="nuke-incoming" />
        </label>
      </fieldset>
    </div>

    <section class="p-4 sm:p-6" aria-live="polite" aria-labelledby={`nuke-results-${lang}`}>
      <h3 id={`nuke-results-${lang}`} class="text-sm font-semibold text-military-200">{t.results}</h3>
      <dl class="mt-4 divide-y divide-iron-800 border-y border-iron-800 text-sm">
        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-3">
          <dt class="text-iron-300">{t.weaponCost}</dt>
          <dd class="font-mono text-right text-iron-50" data-testid="nuke-total-cost"></dd>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-3">
          <dt class="text-iron-300" data-balance-label>{t.remaining}</dt>
          <dd class="font-mono text-right text-iron-50" data-testid="nuke-balance"></dd>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-3">
          <dt class="text-iron-300">{t.nextMirv}</dt>
          <dd class="font-mono text-right text-iron-50" data-testid="nuke-next-mirv"></dd>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-3">
          <dt class="text-iron-300">{t.mirvSeries}</dt>
          <dd class="font-mono text-right text-iron-50" data-testid="nuke-mirv-series"></dd>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-3">
          <dt class="text-iron-300">{t.siloReady}</dt>
          <dd class="font-mono text-right text-iron-50" data-testid="nuke-silo-ready"></dd>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-3">
          <dt class="text-iron-300">{t.samReady}</dt>
          <dd class="font-mono text-right text-iron-50" data-testid="nuke-sam-ready"></dd>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-3">
          <dt class="text-iron-300">{t.samRange}</dt>
          <dd class="font-mono text-right text-iron-50" data-testid="nuke-sam-range"></dd>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-3">
          <dt class="text-iron-300">{t.slotDelta}</dt>
          <dd class="font-mono text-right text-iron-50" data-testid="nuke-slot-delta"></dd>
        </div>
      </dl>
      <p class="mt-3 text-xs text-iron-400" data-testid="nuke-slot-reading"></p>

      <div class="mt-5 border-l-2 border-cannon-500 pl-4">
        <h4 class="text-sm font-semibold text-iron-100">{t.caveatTitle}</h4>
        <p class="mt-1 text-xs leading-relaxed text-iron-300" data-testid="nuke-caveat">{t.caveat}</p>
      </div>
    </section>
  </div>
</section>

<script is:inline define:vars={{ copy }}>
  const ATOM_COST = 750_000n;
  const HYDROGEN_COST = 5_000_000n;
  const MIRV_BASE_COST = 25_000_000n;
  const MIRV_STEP_COST = 15_000_000n;

  function asInteger(container, name, fallback = 0) {
    const field = container.querySelector(`[name="${name}"]`);
    if (!(field instanceof HTMLInputElement)) return fallback;
    const parsed = Number.parseInt(field.value, 10);
    if (!Number.isFinite(parsed)) return fallback;
    const min = field.min === '' ? Number.MIN_SAFE_INTEGER : Number(field.min);
    const max = field.max === '' ? Number.MAX_SAFE_INTEGER : Number(field.max);
    return Math.min(max, Math.max(min, parsed));
  }

  function formatGold(value, locale) {
    const sign = value < 0n ? '-' : '';
    const magnitude = value < 0n ? -value : value;
    return `${sign}${new Intl.NumberFormat(locale).format(magnitude)} Gold`;
  }

  for (const root of document.querySelectorAll('[data-nuke-calculator]')) {
    if (!(root instanceof HTMLElement)) continue;
    const form = root;
    const localeKey = root.dataset.locale || 'en';
    const locale = localeKey === 'zh' ? 'zh-CN' : localeKey;
    const labels = copy[localeKey] ?? copy.en;

    const output = (testId) => root.querySelector(`[data-testid="${testId}"]`);

    const update = () => {
      const gold = BigInt(asInteger(form, 'gold'));
      const globalMirvs = BigInt(asInteger(form, 'globalMirvs'));
      const atoms = BigInt(asInteger(form, 'atoms'));
      const hydrogens = BigInt(asInteger(form, 'hydrogens'));
      const mirvs = BigInt(asInteger(form, 'mirvs'));
      const siloLevel = asInteger(form, 'siloLevel', 1);
      const siloUsed = asInteger(form, 'siloUsed');
      const samLevel = asInteger(form, 'samLevel', 1);
      const samUsed = asInteger(form, 'samUsed');
      const incoming = asInteger(form, 'incoming');

      const nextMirv = MIRV_BASE_COST + MIRV_STEP_COST * globalMirvs;
      const mirvSeries = mirvs * nextMirv + 7_500_000n * mirvs * (mirvs - 1n);
      const totalCost = atoms * ATOM_COST + hydrogens * HYDROGEN_COST + mirvSeries;
      const balance = gold - totalCost;
      const siloReady = Math.max(0, siloLevel - Math.min(siloLevel, siloUsed));
      const samReady = Math.max(0, samLevel - Math.min(samLevel, samUsed));
      const samRange = 150 - 480 / (samLevel + 5);
      const slotDelta = incoming - samReady;

      const values = {
        'nuke-total-cost': [formatGold(totalCost, locale), totalCost.toString()],
        'nuke-balance': [formatGold(balance, locale), balance.toString()],
        'nuke-next-mirv': [formatGold(nextMirv, locale), nextMirv.toString()],
        'nuke-mirv-series': [formatGold(mirvSeries, locale), mirvSeries.toString()],
        'nuke-silo-ready': [String(siloReady), String(siloReady)],
        'nuke-sam-ready': [String(samReady), String(samReady)],
        'nuke-sam-range': [`${new Intl.NumberFormat(locale, { maximumFractionDigits: 1, minimumFractionDigits: 1 }).format(samRange)} tiles`, samRange.toFixed(1)],
        'nuke-slot-delta': [slotDelta > 0 ? `+${slotDelta}` : String(slotDelta), String(slotDelta)],
      };

      for (const [testId, [text, raw]] of Object.entries(values)) {
        const target = output(testId);
        if (target instanceof HTMLElement) {
          target.textContent = text;
          target.dataset.value = raw;
        }
      }

      const balanceLabel = root.querySelector('[data-balance-label]');
      if (balanceLabel) balanceLabel.textContent = balance >= 0n ? labels.remaining : labels.shortfall;

      const reading = output('nuke-slot-reading');
      if (reading) {
        reading.textContent = slotDelta > 0 ? labels.positive : slotDelta === 0 ? labels.neutral : labels.negative;
      }
    };

    root.addEventListener('input', update);
    update();
  }
</script>
