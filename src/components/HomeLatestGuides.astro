---
import { getCollection } from 'astro:content';
import { byLang, getIntlLocale, stripLangPrefix, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const langPrefix = lang === 'en' ? '' : `${lang}/`;
const copy = {
  en: {
    eyebrow: 'LATEST GUIDES',
    title: 'The five newest guides',
    more: 'See all guides',
    updated: 'Updated',
    published: 'Published',
    difficulty: 'Difficulty',
    category: 'Guide',
    empty: 'No guides yet.',
  },
  fr: {
    eyebrow: 'GUIDES RÉCENTS',
    title: 'Les cinq guides les plus récents',
    more: 'Voir tous les guides',
    updated: 'Mis à jour',
    published: 'Publié',
    difficulty: 'Difficulté',
    category: 'Tutoriel',
    empty: 'Aucun tutoriel pour le moment.',
  },
  nl: {
    eyebrow: 'NIEUWSTE GIDSEN',
    title: 'De vijf nieuwste gidsen',
    more: 'Alle gidsen bekijken',
    updated: 'Bijgewerkt',
    published: 'Gepubliceerd',
    difficulty: 'Niveau',
    category: 'Gids',
    empty: 'Nog geen gidsen.',
  },
  de: {
    eyebrow: 'NEUESTE ANLEITUNGEN',
    title: 'Die fünf neuesten Anleitungen',
    more: 'Alle Anleitungen ansehen',
    updated: 'Aktualisiert',
    published: 'Veröffentlicht',
    difficulty: 'Schwierigkeit',
    category: 'Anleitung',
    empty: 'Noch keine Anleitungen.',
  },
  zh: {
    eyebrow: '最新教程',
    title: '最新的五篇教程',
    more: '查看全部教程',
    updated: '更新于',
    published: '发布于',
    difficulty: '难度',
    category: '教程',
    empty: '暂无教程。',
  },
} as const;

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(lang))
  .sort((a, b) => {
    const dateDifference = (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf();
    return dateDifference || stripLangPrefix(a.slug).localeCompare(stripLangPrefix(b.slug));
  })
  .slice(0, 5);

const formatDate = (date: Date) => new Intl.DateTimeFormat(getIntlLocale(lang), { dateStyle: 'medium' }).format(date);
const labels = copy[lang];
---

<section class="border-b border-iron-800 bg-iron-950/30" data-home-latest-guides aria-labelledby="home-latest-guides-title">
  <div class="container-wide py-12 sm:py-14">
    <p class="tag-chip">{labels.eyebrow}</p>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
      <h2 id="home-latest-guides-title" class="text-2xl font-semibold tracking-tight text-iron-50">{labels.title}</h2>
      <a class="text-sm text-cannon-400 hover:underline" href={`${base}${langPrefix}guides/`}>{labels.more}</a>
    </div>
    {guides.length > 0 ? (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {guides.map((guide) => {
          const dateLabel = guide.data.updatedDate ? labels.updated : labels.published;
          return (
            <li>
              <a
                href={`${base}${langPrefix}guides/${stripLangPrefix(guide.slug)}/`}
                class="group flex h-full flex-col rounded-lg border border-iron-800 bg-iron-900/40 p-4 transition-colors hover:border-cannon-700"
                data-home-latest-guide
                data-guide-slug={stripLangPrefix(guide.slug)}
              >
                <div class="flex flex-wrap items-center gap-2 text-xs text-iron-500">
                  <span class="tag-chip">{guide.data.category ?? labels.category}</span>
                  <span class="font-mono">{dateLabel} {formatDate(guide.data.updatedDate ?? guide.data.pubDate)}</span>
                </div>
                <h3 class="mt-3 text-base font-semibold leading-snug text-iron-100 group-hover:text-cannon-300">{guide.data.title}</h3>
                <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-iron-400">{guide.data.description}</p>
                {guide.data.difficulty && <p class="mt-4 text-xs text-iron-500">{labels.difficulty} · {guide.data.difficulty}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="mt-6 text-sm text-iron-400">{labels.empty}</p>
    )}
  </div>
</section>
