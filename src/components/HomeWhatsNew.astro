---
import { getCollection } from 'astro:content';
import { byLang, getIntlLocale, stripLangPrefix, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const langPrefix = lang === 'en' ? '' : `${lang}/`;
const statusRank = { 'not-released': 0, released: 1 } as const;
const entries = (await getCollection('changelog'))
  .filter(byLang(lang))
  .sort((a, b) => statusRank[a.data.releaseStatus] - statusRank[b.data.releaseStatus] || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const formatDate = (date: Date) => new Intl.DateTimeFormat(getIntlLocale(lang), { dateStyle: 'medium' }).format(date);
---

<section class="border-b border-iron-800 bg-iron-950/30" data-home-whats-new aria-labelledby="home-whats-new-title">
  <div class="container-wide py-12 sm:py-14">
    <p class="tag-chip">{t('home.whatsNew.eyebrow')}</p>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
      <h2 id="home-whats-new-title" class="text-2xl font-semibold tracking-tight text-iron-50">{t('home.whatsNew.title')}</h2>
      <a class="text-sm text-cannon-400 hover:underline" href={`${base}${langPrefix}whats-new/`}>{t('home.whatsNew.more')}</a>
    </div>
    <ul class="mt-6 grid gap-3 lg:grid-cols-3">
      {entries.map((entry) => {
        const status = entry.data.releaseStatus;
        return (
          <li>
            <a href={`${base}${langPrefix}changelog/${stripLangPrefix(entry.slug)}/`} class="group block h-full rounded-lg border border-iron-800 bg-iron-900/40 p-4 hover:border-cannon-700">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="text-cannon-400">{status === 'not-released' ? t('whatsNew.status.not-released') : t('whatsNew.status.released')}</span>
                <span class="text-iron-600">·</span>
                <span class="tag-chip">{entry.data.version}</span>
                <span class="text-iron-500">{formatDate(entry.data.pubDate)}</span>
              </div>
              <h3 class="mt-3 text-base font-semibold leading-snug text-iron-100 group-hover:text-cannon-300">{entry.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-iron-400">{entry.data.description}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
