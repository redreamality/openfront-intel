---
import { useTranslations, type Lang } from '../i18n';
import meta from '../data/_meta.json';
import { feedbackIntegration } from '../config/feedback';
import { socialLinks } from '../config/social-links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const langPrefix = lang === 'en' ? '' : `${lang}/`;
// 版本号随 _meta.json 自动更新（由 `pnpm extract` 从上游 OpenFrontIO 抽取），不要写死。
const copyright = t('footer.copyright').replace('{version}', meta.upstreamVersion);
const transparencyCopy = {
  en: { title: 'Transparency', upstream: 'Upstream game source', site: 'Site source', feedback: 'Feedback board', roadmap: 'Site roadmap', privacy: 'Privacy', editorial: 'Editorial policy', contact: 'Contact', cookies: 'Cookie settings' },
  fr: { title: 'Transparence', upstream: 'Code source du jeu', site: 'Code source du site', feedback: 'Tableau de suggestions', roadmap: 'Feuille de route du site', privacy: 'Confidentialité', editorial: 'Politique éditoriale', contact: 'Contact', cookies: 'Préférences cookies' },
  nl: { title: 'Transparantie', upstream: 'Broncode van het spel', site: 'Broncode van de site', feedback: 'Feedbackbord', roadmap: 'Roadmap van de site', privacy: 'Privacy', editorial: 'Redactioneel beleid', contact: 'Contact', cookies: 'Cookie-instellingen' },
  de: { title: 'Transparenz', upstream: 'Quellcode des Spiels', site: 'Website-Quellcode', feedback: 'Feedback-Board', roadmap: 'Website-Roadmap', privacy: 'Datenschutz', editorial: 'Redaktionsrichtlinie', contact: 'Kontakt', cookies: 'Cookie-Einstellungen' },
  zh: { title: '透明度', upstream: '游戏上游源码', site: '本站源码', feedback: '意见反馈', roadmap: '站点路线图', privacy: '隐私政策', editorial: '编辑政策', contact: '联系我们', cookies: 'Cookie 设置' },
} as const;
const legal = transparencyCopy[lang];
---

<footer class="mt-24 border-t border-iron-800 bg-iron-950/80 py-10 text-sm text-iron-400">
  <div class="container-wide grid gap-6 sm:grid-cols-2 lg:grid-cols-6">
    <div>
      <div class="text-iron-100 font-semibold">{t('footer.title')}</div>
      <p class="mt-2 text-iron-400 leading-relaxed">{t('footer.description')}</p>
    </div>
    <div>
      <div class="text-iron-100 font-semibold">{t('footer.navigation')}</div>
      <ul class="mt-2 space-y-1">
        <li><a class="nav-link" href={`${base}${langPrefix}mechanics/`}>{t('nav.mechanics')}</a></li>
        <li><a class="nav-link" href={`${base}${langPrefix}database/`}>{t('nav.database')}</a></li>
        <li><a class="nav-link" href={`${base}${langPrefix}strategies/`}>{t('nav.strategies')}</a></li>
        <li><a class="nav-link" href={`${base}${langPrefix}changelog/`}>{t('nav.changelog')}</a></li>
        <li><a class="nav-link" href={`${base}${langPrefix}shortcuts/`}>{t('nav.shortcuts')}</a></li>
      </ul>
    </div>
    <div>
      <div class="text-iron-100 font-semibold">{t('footer.sources')}</div>
      <ul class="mt-2 space-y-1">
        <li><a class="nav-link" href="https://openfront.io/" rel="noopener" target="_blank">{t('footer.official')}</a></li>
        <li><a class="nav-link" href="https://github.com/openfrontio/OpenFrontIO" rel="noopener" target="_blank">{legal.upstream}</a></li>
        <li><a class="nav-link" href="https://github.com/redreamality/openfront-intel" rel="noopener" target="_blank">{legal.site}</a></li>
        <li>
          <a
            class="nav-link"
            href={feedbackIntegration.feedbackUrl}
            rel="noopener noreferrer"
            target="_blank"
            data-feedback-provider={feedbackIntegration.provider}
          >
            {legal.feedback}
          </a>
        </li>
        {feedbackIntegration.roadmapUrl && (
          <li><a class="nav-link" href={feedbackIntegration.roadmapUrl} rel="noopener noreferrer" target="_blank">{legal.roadmap}</a></li>
        )}
        <li><a class="nav-link" href={`${base}${langPrefix}about/`}>{t('nav.about')}</a></li>
      </ul>
    </div>
    <div>
      <div class="text-iron-100 font-semibold">{legal.title}</div>
      <ul class="mt-2 space-y-1">
        <li><a class="nav-link" href={`${base}${langPrefix}privacy/`}>{legal.privacy}</a></li>
        <li><a class="nav-link" href={`${base}${langPrefix}editorial-policy/`}>{legal.editorial}</a></li>
        <li><a class="nav-link" href={`${base}${langPrefix}contact/`}>{legal.contact}</a></li>
        <li>
          <button class="nav-link text-left" type="button" data-manage-consent data-testid="manage-consent">
            {legal.cookies}
          </button>
        </li>
      </ul>
    </div>
    <div>
      <div class="text-iron-100 font-semibold">{t('footer.community')}</div>
      <ul class="mt-2 space-y-1">
        {socialLinks.filter((link) => link.footer).map((link) => (
          <li>
            <a class="nav-link" href={link.href} rel="noopener noreferrer" target="_blank">{link.labels[lang]}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <div class="text-iron-100 font-semibold">{t('footer.disclaimer')}</div>
      <p class="mt-2 leading-relaxed">{t('footer.disclaimer.text')}</p>
    </div>
  </div>
  <div class="container-wide mt-8 border-t border-iron-800 pt-4 text-xs text-iron-500">
    <span>© {year} {copyright}</span>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll('[data-manage-consent]').forEach((button) => {
    button.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('openfront:manage-consent'));
    });
  });
</script>
