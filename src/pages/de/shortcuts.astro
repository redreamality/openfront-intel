---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideHref = `${base}/de/guides/hotkeys/`;

interface Row { keys: string[]; action: string }
interface Group { id: string; label: string; note?: string; rows: Row[] }

const groups: Group[] = [
  {
    id: 'build',
    label: 'Bau- & Einheiten-Zahlentasten',
    note: 'Einmal drücken ergibt x1. Derselbe Hotkey schaltet beim vorhandenen Upgrade oder bei der Atom Bomb auf x5; Neubau, Hydrogen Bomb und MIRV bleiben x1.',
    rows: [
      { keys: ['1'], action: 'Stadt (City) bauen' },
      { keys: ['2'], action: 'Fabrik (Factory) bauen' },
      { keys: ['3'], action: 'Hafen (Port) bauen' },
      { keys: ['4'], action: 'Verteidigungsposten (Defense Post) bauen' },
      { keys: ['5'], action: 'Raketensilo (Missile Silo) bauen' },
      { keys: ['6'], action: 'SAM-Werfer bauen' },
      { keys: ['7'], action: 'Kriegsschiff (Warship) bauen' },
      { keys: ['8'], action: 'Atombombe — bleibt scharf; 8 erneut drücken wählt ein x5-Paket aus geladenen Rohren' },
      { keys: ['9'], action: 'Wasserstoffbombe — bleibt für Salven scharf' },
      { keys: ['0'], action: 'MIRV' },
      { keys: ['Enter'], action: 'Scharfe Einheit unter dem Cursor bauen' },
      { keys: ['U'], action: 'Flugbogen einer scharfen Nuke umdrehen (hoch / runter)' },
      { keys: ['Esc'], action: 'Bau-Vorschau abbrechen' },
    ],
  },
  {
    id: 'mouse',
    label: 'Maussteuerung',
    note: 'Standardschema. Tasten lassen sich in Einstellungen → „Linksklick öffnet Menü" tauschen.',
    rows: [
      { keys: ['Linksklick'], action: 'Feind / herrenlose Grenze angreifen oder Transport übers Wasser senden' },
      { keys: ['Linksklick'], action: 'Scharfes Gebäude auf eigenem Land platzieren' },
      { keys: ['Rechtsklick'], action: 'In v33.1 aktive Warship- / Bootsauswahl aufheben; sonst Radial- / Baumenü öffnen' },
      { keys: ['Strg', 'Linksklick'], action: 'Baumenü an dieser Stelle öffnen' },
      { keys: ['Alt', 'Linksklick'], action: 'Emote-Menü öffnen' },
      { keys: ['Shift', 'Ziehen'], action: 'Mehrere Kriegsschiffe per Box auswählen' },
      { keys: ['Mausrad'], action: 'Zoom' },
      { keys: ['Mitte-Ziehen'], action: 'Ansicht verschieben' },
    ],
  },
  {
    id: 'camera',
    label: 'Ansicht & Kamera',
    note: 'Im geöffneten Emoji-Menü wählen Q W E A S D Favoriten, statt die Kamera zu bewegen oder zu zoomen.',
    rows: [
      { keys: ['Space'], action: 'Ansicht wechseln (Gelände / Länder)' },
      { keys: ['M'], action: 'Koordinatengitter ein-/ausblenden' },
      { keys: ['C'], action: 'Kamera auf eigene Nation zentrieren' },
      { keys: ['Q'], action: 'Herauszoomen' },
      { keys: ['E'], action: 'Hineinzoomen' },
      { keys: ['+', '-'], action: 'Zoom (Ersatz)' },
      { keys: ['W', 'A', 'S', 'D'], action: 'Kamera verschieben' },
      { keys: ['P'], action: 'Pause / fortsetzen' },
      { keys: [',', '.'], action: 'Spieltempo runter / hoch (Einzelspieler)' },
    ],
  },
  {
    id: 'combat',
    label: 'Kampf',
    rows: [
      { keys: ['T'], action: 'Angriffsverhältnis senken' },
      { keys: ['Y'], action: 'Angriffsverhältnis erhöhen' },
      { keys: ['B'], action: 'Boots-(See-)Angriff auf das Ziel starten' },
      { keys: ['G'], action: 'Bodenangriff auf das Ziel starten' },
      { keys: ['Shift', 'R'], action: 'Gegen den letzten Angreifer zurückschlagen' },
      { keys: ['X'], action: 'Alle eigenen Kriegsschiffe auswählen' },
      { keys: ['Shift', 'Ziehen'], action: 'Mehrere Kriegsschiffe auswählen' },
    ],
  },
  {
    id: 'diplomacy',
    label: 'Diplomatie',
    rows: [
      { keys: ['F'], action: 'Emoji-Menü öffnen / schließen' },
      { keys: ['R'], action: 'Schnellchat für den Spieler unter dem Zeiger öffnen' },
      { keys: ['K'], action: 'Bündnis mit dem anvisierten Spieler anfragen' },
      { keys: ['L'], action: 'Bündnis brechen' },
    ],
  },
  {
    id: 'misc',
    label: 'Sonstiges',
    rows: [
      { keys: ['Esc'], action: 'Menü schließen / Bau-Vorschau abbrechen' },
      { keys: ['Enter'], action: 'Einheit unter dem Cursor bauen' },
      { keys: ['Alt', 'R'], action: 'Grafik zurücksetzen' },
    ],
  },
];
---

<BaseLayout
  title="OpenFront Tastenkürzel"
  description="OpenFront.io-v35-Tasten: X wählt alle Warships, F öffnet Emojis, R den Schnellchat. Prüfe deine gespeicherte Belegung vor den Übungen."
>
  <PageHeader
    eyebrow="SHORTCUTS"
    title="OpenFront Tastenkürzel"
    lead="Diese Seite ist die feste Referenz zum schnellen Nachschlagen der v35-Standardtasten, Maussteuerungen und Bau-Hotkeys von OpenFront.io. Für Gefechtsabläufe, Übungen und Eingabeerholung nutze den separaten Hotkey-Guide. Die meisten Aktionen lassen sich unter Einstellungen → Tastenbelegung ändern, auch die drei Abläufe unten. Unter macOS gilt Strg als Cmd."
  />

  <section class="container-wide py-10 space-y-10">
    <p class="border-l-2 border-cannon-500 pl-4 text-sm text-iron-300">
      <strong class="text-iron-100">X/F/R und Neubelegung am 21. Oktober 2026 in v0.35.2 stable geprüft; bestehende Baubeispiele behalten ihren bisherigen Geltungsbereich.</strong>
      Derselbe Bau-Hotkey schaltet beim vorhandenen Upgrade oder bei der Atom Bomb zwischen x1 / x5. Das Radialmenü bietet x1/x5/x10/xMax für Gebäude und x1/x2/x5/xMax für Atom Bombs; Gold und geladene Silo-Rohre begrenzen xMax.
    </p>

    <aside data-keybinding-boundary class="rounded border border-cannon-700/60 bg-cannon-950/20 p-4 text-sm leading-relaxed text-iron-300">
      <strong class="text-cannon-300">Neubelegung in v0.35.2.</strong>
      Einstellungen → Tastenbelegung bietet eigene Einträge für <kbd class="kbd">X</kbd> (alle Warships), den <kbd class="kbd">R</kbd>-Teil des Grafik-Resets (Standard Alt+R) und <kbd class="kbd">Shift</kbd> + Ziehen zur Boxauswahl. Deine gespeicherte Belegung hat Vorrang. Die <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/blob/v0.35.2/src/client/UserSettingModal.ts">offiziellen v0.35.2-Einstellungen</a> enthalten alle drei Aktionen.
      Seit <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/releases/tag/v0.35.0">v0.35.0 stable</a> ersetzt X die alte Flottentaste F aus v34: F öffnet Emojis und R den Schnellchat. Ist F für die Flotte gespeichert, prüfe auch Emojis; ein neuer Standard kann bei einem Konflikt gelöst werden.
    </aside>

    <a
      href={guideHref}
      class="block rounded border border-cannon-700/50 bg-cannon-950/30 px-4 py-3 text-sm text-iron-200 transition-colors hover:border-cannon-500"
    >
      <span class="font-semibold text-cannon-300">Neu hier?</span>
      Der schnellste Vorteil sind die Bau-Zahlentasten — <kbd class="kbd">8</kbd> einmal für x1 oder zweimal für x5, dann klicken. Dasselbe Silo feuert im Tick-Abstand; getrennte bereite Silos können gemeinsam starten. Für Übungen lies den ausführlichen
      <span class="underline decoration-dotted">Hotkey-Guide →</span>
    </a>

    {groups.map((g) => (
      <section id={g.id}>
        <h2 class="text-xl font-semibold text-iron-50 border-b border-iron-800 pb-2 mb-1">{g.label}</h2>
        {g.note && <p class="text-sm text-iron-400 mb-3">{g.note}</p>}
        <table class="w-full text-sm">
          <tbody>
            {g.rows.map((r) => (
              <tr class="border-b border-iron-800/70">
                <td class="py-2 pr-4 w-44 align-top whitespace-nowrap">
                  {r.keys.map((k, i) => (
                    <>
                      {i > 0 && <span class="mx-1 text-iron-600">+</span>}
                      <kbd class="kbd">{k}</kbd>
                    </>
                  ))}
                </td>
                <td class="py-2 text-iron-300 align-top">{r.action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}

    <p class="text-sm text-iron-400">
      Wenn die Belegung sitzt, nutze den <a class="text-cannon-300 hover:text-cannon-200" href={`${base}/de/mechanics/economy/`}>Wirtschaftsguide</a> für die Bauentscheidung und die <a class="text-cannon-300 hover:text-cannon-200" href={`${base}/de/mechanics/nukes/`}>Nuklearmechanik-Referenz</a> vor Übungen zu Start und Abfang.
    </p>

    <p class="text-xs text-iron-500">
      Dies sind v35-Standardbelegungen. In v0.35.2 lassen sich auch alle Warships, Grafik-Reset und Boxauswahl neu belegen; prüfe vor den Übungen deine gespeicherten Einstellungen.
    </p>
  </section>
</BaseLayout>

<style>
  .kbd {
    display: inline-block;
    min-width: 1.4rem;
    text-align: center;
    border: 1px solid rgb(63 63 70 / 0.9);
    border-bottom-width: 2px;
    border-radius: 0.25rem;
    background: rgb(24 24 27 / 0.9);
    padding: 0.05rem 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: rgb(228 228 231);
    line-height: 1.4;
  }
</style>
