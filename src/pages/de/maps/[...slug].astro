---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../../layouts/DocLayout.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const LANG = 'de';

export async function getStaticPaths() {
  const posts = (await getCollection('maps')).filter((post) => post.slug.startsWith('de/'));
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^de\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL;
const others = (await getCollection('maps'))
  .filter(byLang(LANG))
  .filter((entry) => entry.slug !== post.slug)
  .map((entry) => ({
    href: `${base}de/maps/${stripLangPrefix(entry.slug)}/`,
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.pubDate,
  }));
---

<DocLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  difficulty={post.data.difficulty}
  category={post.data.category}
  version={post.data.version}
  freshnessSummary={post.data.freshnessSummary}
  collection="maps"
  headings={headings}
  related={others}
  eyebrow="KARTEN"
>
  <Content />
</DocLayout>
