---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CollectionIntro from '../../../components/CollectionIntro.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const LANG = 'de';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(LANG))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const fmt = (d: Date) => new Intl.DateTimeFormat('de-DE', { dateStyle: 'medium' }).format(d);
const updatedLabel = 'Aktualisiert';
---

<BaseLayout title="Anleitungen" description="OpenFront.io Tutorials vom Anfänger bis Fortgeschrittenen, Bedienfeld, Tastenkürzel und Analyse der ersten Partie.">
  <PageHeader eyebrow="GUIDES" title="Anleitungen" lead="Schritt für Schritt vom Öffnen des Spiels bis zu deiner ersten erfolgreichen Expansion." />
  <CollectionIntro kind="guide" />
  <section class="container-wide pt-8" aria-labelledby="water-nukes-route" data-water-nukes-route>
    <h2 id="water-nukes-route" class="text-lg font-semibold text-iron-50">Suchst du nach Water Nukes?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Öffne direkt den <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}de/guides/water-nukes/`}>eigenständigen Water-Nukes-Guide</a> für Geländeumwandlung, Angriffsentscheidungen, Verteidigung und typische Fehler.
    </p>
  </section>
  <section class="container-wide py-10">
    {all.length === 0 ? (
      <p class="text-iron-400">Noch keine Anleitungen.</p>
    ) : (
      <ul class="space-y-4">
        {all.map((post) => (
          <li>
            <a href={`${base}de/guides/${stripLangPrefix(post.slug)}/`} class="block card group">
              <div class="flex flex-wrap items-center gap-2 text-xs text-iron-500">
                <span class="tag-chip">{post.data.category ?? 'Anleitung'}</span>
                {post.data.difficulty && <span class="tag-chip">Schwierigkeit · {post.data.difficulty}</span>}
                <span class="font-mono">{post.data.updatedDate ? `${updatedLabel} ${fmt(post.data.updatedDate)}` : fmt(post.data.pubDate)}</span>
              </div>
              <h2 class="mt-2 text-lg font-semibold text-cannon-400 group-hover:text-cannon-300">{post.data.title}</h2>
              <p class="mt-2 text-sm text-iron-300 leading-relaxed">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
