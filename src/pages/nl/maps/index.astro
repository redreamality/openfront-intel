---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const base = import.meta.env.BASE_URL;
const maps = (await getCollection('maps', ({ data }) => !data.draft))
  .filter(byLang('nl'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'nl'));
---

<BaseLayout title="OpenFront-kaartgidsen" description="Gedetailleerde, brongecontroleerde strategiepagina's voor afzonderlijke OpenFront-kaarten.">
  <PageHeader eyebrow="KAARTEN" title="Kaartgidsen" lead="Kies een kaart voor gecontroleerde terreindata, spawnvragen, routes, Compact-verschillen en tegenmaatregelen." />
  <section class="container-wide py-10" aria-labelledby="map-list">
    <h2 id="map-list" class="sr-only">Beschikbare kaartgidsen</h2>
    <ul class="grid gap-4 md:grid-cols-2">
      {maps.map((map) => (
        <li>
          <a href={`${base}nl/maps/${stripLangPrefix(map.slug)}/`} class="block card group h-full">
            <span class="tag-chip">{map.data.category ?? 'Kaartgids'}</span>
            <h2 class="mt-3 text-xl font-semibold text-cannon-400 group-hover:text-cannon-300">{map.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-iron-300">{map.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
