---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CollectionIntro from '../../../components/CollectionIntro.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const LANG = 'nl';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(LANG))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const fmt = (d: Date) => new Intl.DateTimeFormat('nl-NL', { dateStyle: 'medium' }).format(d);
const updatedLabel = 'Bijgewerkt';
---

<BaseLayout title="Gidsen" description="OpenFront.io tutorials van beginner tot gevorderd, bedieningspaneel, sneltoetsen en analyse van je eerste partij.">
  <PageHeader eyebrow="GUIDES" title="Gidsen" lead="Stap voor stap van het openen van het spel tot je eerste succesvolle expansie." />
  <CollectionIntro kind="guide" />
  <section class="container-wide pt-8" aria-labelledby="overtime-route" data-overtime-route>
    <h2 id="overtime-route" class="text-lg font-semibold text-iron-50">Gaat Overtime de partij beëindigen?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Gebruik de <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}nl/guides/winning-overtime/`}>win- en Overtime-gids</a> om de dalende gebiedsdrempel te lezen, de volgende stap van 30 seconden te berekenen en de voorsprong te verdedigen of aan te vallen.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="water-nukes-route" data-water-nukes-route>
    <h2 id="water-nukes-route" class="text-lg font-semibold text-iron-50">Zoek je Water Nukes?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Ga rechtstreeks naar de <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}nl/guides/water-nukes/`}>aparte Water Nukes-gids</a> voor terreinverandering, aanvalskeuzes, verdediging en veelgemaakte fouten.
    </p>
  </section>
  <section class="container-wide pt-6" aria-labelledby="doomsday-route" data-doomsday-route>
    <h2 id="doomsday-route" class="text-lg font-semibold text-iron-50">Zoek je de Doomsday Clock-regels?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Gebruik de <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}nl/guides/doomsday-clock/`}>complete Doomsday Clock-gids</a> voor de werking van de modus, alle landgolven, waarschuwing, verval, herstel en counters.
    </p>
  </section>
  <section class="container-wide py-10">
    {all.length === 0 ? (
      <p class="text-iron-400">Nog geen gidsen.</p>
    ) : (
      <ul class="space-y-4">
        {all.map((post) => (
          <li>
            <a href={`${base}nl/guides/${stripLangPrefix(post.slug)}/`} class="block card group">
              <div class="flex flex-wrap items-center gap-2 text-xs text-iron-500">
                <span class="tag-chip">{post.data.category ?? 'Gids'}</span>
                {post.data.difficulty && <span class="tag-chip">Moeilijkheid · {post.data.difficulty}</span>}
                <span class="font-mono">{post.data.updatedDate ? `${updatedLabel} ${fmt(post.data.updatedDate)}` : fmt(post.data.pubDate)}</span>
              </div>
              <h2 class="mt-2 text-lg font-semibold text-cannon-400 group-hover:text-cannon-300">{post.data.title}</h2>
              <p class="mt-2 text-sm text-iron-300 leading-relaxed">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
