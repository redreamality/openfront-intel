---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideHref = `${base}/nl/guides/hotkeys/`;

interface Row { keys: string[]; action: string }
interface Group { id: string; label: string; note?: string; rows: Row[] }

const groups: Group[] = [
  {
    id: 'build',
    label: 'Bouw- & eenheid-cijfertoetsen',
    note: 'Eén druk geeft x1. Druk dezelfde toets opnieuw voor x5 bij een bestaande upgrade of Atom Bomb; nieuwbouw, Hydrogen Bomb en MIRV blijven x1.',
    rows: [
      { keys: ['1'], action: 'Stad (City) bouwen' },
      { keys: ['2'], action: 'Fabriek (Factory) bouwen' },
      { keys: ['3'], action: 'Haven (Port) bouwen' },
      { keys: ['4'], action: 'Verdedigingspost (Defense Post) bouwen' },
      { keys: ['5'], action: 'Raketsilo (Missile Silo) bouwen' },
      { keys: ['6'], action: 'SAM-lanceerder bouwen' },
      { keys: ['7'], action: 'Oorlogsschip (Warship) bouwen' },
      { keys: ['8'], action: 'Atoombom — blijft scherp; druk 8 opnieuw voor een x5-bundel uit geladen buizen' },
      { keys: ['9'], action: 'Waterstofbom — blijft scherp voor salvo\'s' },
      { keys: ['0'], action: 'MIRV' },
      { keys: ['Enter'], action: 'Scherpe eenheid onder de cursor bouwen' },
      { keys: ['U'], action: 'Lanceerboog van een scherpe nuke omdraaien (omhoog / omlaag)' },
      { keys: ['Esc'], action: 'Bouwvoorbeeld annuleren' },
    ],
  },
  {
    id: 'mouse',
    label: 'Muisbediening',
    note: 'Standaardschema. Knoppen wisselen kan in Instellingen → „Linksklik opent menu".',
    rows: [
      { keys: ['Linksklik'], action: 'Vijand / niemandsland-grens aanvallen, of transport over water sturen' },
      { keys: ['Linksklik'], action: 'Het scherpe gebouw op eigen land plaatsen' },
      { keys: ['Rechtsklik'], action: 'In v33.1 een actieve oorlogsschip- / bootselectie wissen; anders het radiale / bouwmenu openen' },
      { keys: ['Ctrl', 'Linksklik'], action: 'Bouwmenu op die plek openen' },
      { keys: ['Alt', 'Linksklik'], action: 'Emote-menu openen' },
      { keys: ['Shift', 'Slepen'], action: 'Meerdere oorlogsschepen selecteren (kader)' },
      { keys: ['Wiel'], action: 'Zoomen' },
      { keys: ['Midden-slepen'], action: 'Beeld verschuiven' },
    ],
  },
  {
    id: 'camera',
    label: 'Beeld & camera',
    rows: [
      { keys: ['Space'], action: 'Wisselweergave (terrein / landen)' },
      { keys: ['M'], action: 'Coördinatenraster aan/uit' },
      { keys: ['C'], action: 'Camera centreren op je natie' },
      { keys: ['Q'], action: 'Uitzoomen' },
      { keys: ['E'], action: 'Inzoomen' },
      { keys: ['+', '-'], action: 'Zoom (reserve)' },
      { keys: ['W', 'A', 'S', 'D'], action: 'Camera verschuiven' },
      { keys: ['P'], action: 'Pauze / hervatten' },
      { keys: [',', '.'], action: 'Spelsnelheid omlaag / omhoog (singleplayer)' },
    ],
  },
  {
    id: 'combat',
    label: 'Gevecht',
    rows: [
      { keys: ['T'], action: 'Aanvalsratio verlagen' },
      { keys: ['Y'], action: 'Aanvalsratio verhogen' },
      { keys: ['B'], action: 'Boot- (zee-)aanval richting doel starten' },
      { keys: ['G'], action: 'Grondaanval richting doel starten' },
      { keys: ['Shift', 'R'], action: 'Terugslaan tegen de speler die je het laatst aanviel' },
      { keys: ['F'], action: 'Al je oorlogsschepen selecteren' },
      { keys: ['Shift', 'Slepen'], action: 'Meerdere oorlogsschepen selecteren' },
    ],
  },
  {
    id: 'diplomacy',
    label: 'Diplomatie',
    rows: [
      { keys: ['K'], action: 'Bondgenootschap aanvragen bij de aangewezen speler' },
      { keys: ['L'], action: 'Bondgenootschap verbreken' },
    ],
  },
  {
    id: 'misc',
    label: 'Overig',
    rows: [
      { keys: ['Esc'], action: 'Menu sluiten / bouwvoorbeeld annuleren' },
      { keys: ['Enter'], action: 'Eenheid onder de cursor bouwen' },
      { keys: ['Alt', 'R'], action: 'Graphics resetten' },
    ],
  },
];
---

<BaseLayout
  title="OpenFront sneltoetsen"
  description="Het complete OpenFront.io v33.5-sneltoetsenoverzicht: standaardtoetsen, muisbediening, bouw-hotkeys en bundelacties."
>
  <PageHeader
    eyebrow="SHORTCUTS"
    title="OpenFront sneltoetsen"
    lead="Alle standaard sneltoetsen, muisbediening en bouw-hotkeys van OpenFront.io, gegroepeerd op gebruik voor snel opzoeken. Sinds v24 zijn de meeste actiebindings te wijzigen via Instellingen → Toetsindeling; v33.5 heeft nog de vaste uitzonderingen hieronder. Op macOS geldt Ctrl als Cmd."
  />

  <section class="container-wide py-10 space-y-10">
    <p class="border-l-2 border-cannon-500 pl-4 text-sm text-iron-300">
      <strong class="text-iron-100">Geldig voor v33.5 · gecontroleerd op 16 augustus 2026.</strong>
      Dezelfde bouwtoets wisselt bij een bestaande upgrade of Atom Bomb tussen x1 / x5. Het radiale menu biedt x1/x5/x10/xMax voor gebouwen en x1/x2/x5/xMax voor Atom Bombs; goud en geladen Silo-buizen begrenzen xMax.
    </p>

    <aside data-keybinding-boundary class="rounded border border-cannon-700/60 bg-cannon-950/20 p-4 text-sm leading-relaxed text-iron-300">
      <strong class="text-cannon-300">Herindelingsgrens in v33.5.</strong>
      Instellingen → Toetsindeling kan veel acties wijzigen, maar heeft geen aparte optie voor <kbd class="kbd">F</kbd> (alle oorlogsschepen selecteren), het <kbd class="kbd">R</kbd>-deel van de grafische reset of <kbd class="kbd">Shift</kbd> + slepen voor vakselectie. Houd deze standaardtoetsen in de huidige versie aan. De <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/blob/v0.33.5/src/client/UserSettingModal.ts">officiële v33.5-broncode</a> toont dat de opties ontbreken; een <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/commit/ead15d8d1428697d8fc0d1221b849892bbb8c163">nog niet uitgebrachte upstreamwijziging</a> voegt ze toe.
    </aside>

    <a
      href={guideHref}
      class="block rounded border border-cannon-700/50 bg-cannon-950/30 px-4 py-3 text-sm text-iron-200 transition-colors hover:border-cannon-500"
    >
      <span class="font-semibold text-cannon-300">Nieuw hier?</span>
      De snelste winst zijn de bouw-cijfertoetsen — tik <kbd class="kbd">8</kbd> eenmaal voor x1 of tweemaal voor x5 en klik. Dezelfde Silo vuurt per tick; verschillende gereedstaande Silos kunnen samen starten. Voor oefeningen lees je de uitgebreide
      <span class="underline decoration-dotted">hotkey-gids →</span>
    </a>

    {groups.map((g) => (
      <section id={g.id}>
        <h2 class="text-xl font-semibold text-iron-50 border-b border-iron-800 pb-2 mb-1">{g.label}</h2>
        {g.note && <p class="text-sm text-iron-400 mb-3">{g.note}</p>}
        <table class="w-full text-sm">
          <tbody>
            {g.rows.map((r) => (
              <tr class="border-b border-iron-800/70">
                <td class="py-2 pr-4 w-44 align-top whitespace-nowrap">
                  {r.keys.map((k, i) => (
                    <>
                      {i > 0 && <span class="mx-1 text-iron-600">+</span>}
                      <kbd class="kbd">{k}</kbd>
                    </>
                  ))}
                </td>
                <td class="py-2 text-iron-300 align-top">{r.action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}

    <p class="text-sm text-iron-400">
      Ken je de indeling, gebruik dan de <a class="text-cannon-300 hover:text-cannon-200" href={`${base}/nl/mechanics/economy/`}>economiegids</a> om te kiezen wat je bouwt en de <a class="text-cannon-300 hover:text-cannon-200" href={`${base}/nl/mechanics/nukes/`}>kernwapenreferentie</a> voordat je lanceren en onderscheppen oefent.
    </p>

    <p class="text-xs text-iron-500">
      Dit zijn de v33.5-standaardindelingen in het spel, gecontroleerd tegen de officiële tag. De meeste opties zijn te wijzigen; <kbd class="kbd">F</kbd>, grafische-reset-<kbd class="kbd">R</kbd> en vakselectie-<kbd class="kbd">Shift</kbd> staan in deze versie vast.
    </p>
  </section>
</BaseLayout>

<style>
  .kbd {
    display: inline-block;
    min-width: 1.4rem;
    text-align: center;
    border: 1px solid rgb(63 63 70 / 0.9);
    border-bottom-width: 2px;
    border-radius: 0.25rem;
    background: rgb(24 24 27 / 0.9);
    padding: 0.05rem 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: rgb(228 228 231);
    line-height: 1.4;
  }
</style>
