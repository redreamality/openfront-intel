---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../../layouts/DocLayout.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const LANG = 'nl';

export async function getStaticPaths() {
  const posts = (await getCollection('strategies')).filter((p) => p.slug.startsWith('nl/'));
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^nl\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL;
const currentTags = new Set(post.data.tags ?? []);
const currentCategory = post.data.category;

const others = (await getCollection('strategies'))
  .filter(byLang(LANG))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => {
    const aSharedTags = (a.data.tags ?? []).filter((tag) => currentTags.has(tag)).length;
    const bSharedTags = (b.data.tags ?? []).filter((tag) => currentTags.has(tag)).length;
    if (aSharedTags !== bSharedTags) return bSharedTags - aSharedTags;

    const aCategoryMatch = currentCategory && a.data.category === currentCategory ? 1 : 0;
    const bCategoryMatch = currentCategory && b.data.category === currentCategory ? 1 : 0;
    if (aCategoryMatch !== bCategoryMatch) return bCategoryMatch - aCategoryMatch;

    const aDate = (a.data.updatedDate ?? a.data.pubDate).getTime();
    const bDate = (b.data.updatedDate ?? b.data.pubDate).getTime();
    if (aDate !== bDate) return bDate - aDate;

    return a.slug.localeCompare(b.slug);
  })
  .slice(0, 4)
  .map((p) => ({
    href: `${base}nl/strategies/${stripLangPrefix(p.slug)}/`,
    title: p.data.title,
    description: p.data.description,
    date: p.data.pubDate,
  }));
---

<DocLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  difficulty={post.data.difficulty}
  category={post.data.category}
  version={post.data.version}
  freshnessSummary={post.data.freshnessSummary}
  collection="strategies"
  headings={headings}
  related={others}
  eyebrow="STRATEGIES"
>
  <Content />
</DocLayout>
