---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideHref = `${base}/fr/guides/hotkeys/`;

interface Row { keys: string[]; action: string }
interface Group { id: string; label: string; note?: string; rows: Row[] }

const groups: Group[] = [
  {
    id: 'build',
    label: 'Touches chiffrées (bâtiments & unités)',
    note: 'Au même endroit, répétez la touche pour 1 → 5 → 10 → 15, puis par 5 jusqu’à 50 et retour à 1. Cette quantité concerne les améliorations et les Atom Bombs ; nouvelle structure, Hydrogen Bomb et MIRV restent x1.',
    rows: [
      { keys: ['1'], action: 'Construire une Ville (City)' },
      { keys: ['2'], action: 'Construire une Usine (Factory)' },
      { keys: ['3'], action: 'Construire un Port' },
      { keys: ['4'], action: 'Construire un Poste de défense (Defense Post)' },
      { keys: ['5'], action: 'Construire un Silo à missiles (Missile Silo)' },
      { keys: ['6'], action: 'Construire un Lanceur SAM' },
      { keys: ['7'], action: 'Construire un Navire de guerre (Warship)' },
      { keys: ['8'], action: 'Bombe atomique — reste armée ; répétez 8 pour augmenter le lot, limité par l’or et les tubes chargés' },
      { keys: ['9'], action: 'Bombe à hydrogène — reste armée pour tirer en rafale' },
      { keys: ['0'], action: 'MIRV' },
      { keys: ['Enter'], action: 'Construire l\'unité armée sous le curseur' },
      { keys: ['U'], action: 'Inverser l\'arc de tir d\'une nuke armée (haut / bas)' },
      { keys: ['Esc'], action: 'Annuler l\'aperçu de construction' },
      { keys: ['H'], action: 'Maintenir pour construire séparément au lieu d’améliorer une structure proche' },
      { keys: ['Alt', 'Molette'], action: 'Ajuster la quantité de 1 entre 1 et 50, sans zoomer' },
    ],
  },
  {
    id: 'mouse',
    label: 'Commandes souris',
    note: 'Schéma par défaut. On peut échanger les boutons dans Paramètres → « Le clic gauche ouvre le menu ».',
    rows: [
      { keys: ['Clic gauche'], action: 'Attaquer un ennemi / une frontière libre, ou envoyer un transport sur l\'eau' },
      { keys: ['Clic gauche'], action: 'Placer le bâtiment armé sur votre territoire' },
      { keys: ['Clic droit'], action: 'En v33.1, annuler une sélection active de Warship / bateau ; sinon ouvrir le menu radial / de construction' },
      { keys: ['Ctrl', 'Clic gauche'], action: 'Ouvrir le menu de construction à cet endroit' },
      { keys: ['Alt', 'Clic gauche'], action: 'Ouvrir le menu d\'émotes' },
      { keys: ['Shift', 'Glisser'], action: 'Sélectionner plusieurs navires (cadre)' },
      { keys: ['Molette'], action: 'Zoom' },
      { keys: ['Glisser-milieu'], action: 'Déplacer la vue' },
    ],
  },
  {
    id: 'camera',
    label: 'Vue & caméra',
    note: 'Quand le menu emoji est ouvert, Q W E A S D choisissent les favoris au lieu de déplacer ou zoomer la caméra.',
    rows: [
      { keys: ['Space'], action: 'Vue alternative (terrain / pays)' },
      { keys: ['M'], action: 'Afficher/masquer la grille de coordonnées' },
      { keys: ['C'], action: 'Centrer la caméra sur votre nation' },
      { keys: ['Q'], action: 'Dézoomer' },
      { keys: ['E'], action: 'Zoomer' },
      { keys: ['+', '-'], action: 'Zoom (secours)' },
      { keys: ['W', 'A', 'S', 'D'], action: 'Déplacer la caméra' },
      { keys: ['P'], action: 'Pause / reprendre' },
      { keys: [',', '.'], action: 'Vitesse du jeu — / + (solo)' },
    ],
  },
  {
    id: 'combat',
    label: 'Combat',
    rows: [
      { keys: ['T'], action: 'Baisser le ratio d\'attaque' },
      { keys: ['Y'], action: 'Augmenter le ratio d\'attaque' },
      { keys: ['B'], action: 'Lancer une attaque navale (bateau) vers la cible' },
      { keys: ['G'], action: 'Lancer une attaque terrestre vers la cible' },
      { keys: ['Shift', 'R'], action: 'Riposter contre le dernier joueur qui vous a attaqué' },
      { keys: ['X'], action: 'Sélectionner tous vos navires de guerre' },
      { keys: ['Shift', 'Glisser'], action: 'Sélectionner plusieurs navires de guerre' },
    ],
  },
  {
    id: 'diplomacy',
    label: 'Diplomatie',
    rows: [
      { keys: ['F'], action: 'Ouvrir / fermer le menu emoji' },
      { keys: ['R'], action: 'Ouvrir le chat rapide pour le joueur sous le curseur' },
      { keys: ['K'], action: 'Demander une alliance au joueur survolé' },
      { keys: ['L'], action: 'Rompre une alliance' },
      { keys: ['J'], action: 'Envoyer des troupes à l’allié sous le curseur' },
      { keys: ['O'], action: 'Ouvrir la fenêtre d’envoi d’or à l’allié sous le curseur' },
      { keys: ['I'], action: 'Afficher ou masquer le panneau du joueur sous le curseur' },
    ],
  },
  {
    id: 'misc',
    label: 'Divers',
    rows: [
      { keys: ['Esc'], action: 'Fermer le menu / annuler l\'aperçu de construction' },
      { keys: ['Enter'], action: 'Construire l\'unité sous le curseur' },
      { keys: ['Alt', 'R'], action: 'Réinitialiser les graphismes' },
    ],
  },
];
---

<BaseLayout
  title="Raccourcis OpenFront"
  description="Raccourcis OpenFront.io v36 : dons J/O, panneau I, construction séparée H, quantités et souris. Vérifiez vos touches enregistrées."
>
  <PageHeader
    eyebrow="SHORTCUTS"
    title="Raccourcis OpenFront"
    lead="Cette page est la référence de consultation des touches par défaut : clavier, souris et construction dans OpenFront.io, avec les ajouts v36 ci-dessous. Pour les enchaînements de combat, l'entraînement et la récupération après erreur, utilisez le guide Hotkeys séparé. La plupart des commandes sont réassignables dans Paramètres → Raccourcis. Sur macOS, lisez Ctrl comme Cmd."
  />

  <section class="container-wide py-10 space-y-10">
    <p class="border-l-2 border-cannon-500 pl-4 text-sm text-iron-300">
      <strong class="text-iron-100">J/O/I/H et quantités vérifiés en <a href="https://github.com/openfrontio/OpenFrontIO/releases/tag/v0.36.2" class="underline">v0.36.2</a> stable le 14 novembre 2026.</strong>
      Au même endroit, répétez la touche pour 1 → 5 → 10 → 15, puis par 5 jusqu’à 50 et retour à 1. Alt+molette ajuste de 1. Les améliorations et Atom Bombs utilisent cette quantité ; nouvelle structure, Hydrogen Bomb et MIRV restent x1. L’or et les tubes chargés limitent toujours les lots atomiques.
      Les touches affichées suivent votre clavier, dont ZQSD sur AZERTY. Vos réglages enregistrés priment. Le guide d’entraînement conserve sa portée v35 annoncée.
    </p>

    <aside data-keybinding-boundary class="rounded border border-cannon-700/60 bg-cannon-950/20 p-4 text-sm leading-relaxed text-iron-300">
      <strong class="text-cannon-300">Réassignation en v0.35.2.</strong>
      Paramètres → Raccourcis propose des entrées dédiées pour <kbd class="kbd">X</kbd> (tous les navires), le <kbd class="kbd">R</kbd> de la réinitialisation graphique (Alt+R par défaut) et <kbd class="kbd">Maj</kbd> + glisser pour la sélection en boîte. Vos réglages priment. Les <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/blob/v0.35.2/src/client/UserSettingModal.ts">réglages officiels v0.35.2</a> exposent ces trois actions.
      La <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/releases/tag/v0.35.0">v0.35.0 stable</a> remplace le F naval de v34 par X : F ouvre les emojis et R le chat rapide. Si votre touche navale enregistrée reste F, vérifiez aussi les emojis ; une nouvelle valeur en conflit peut être désassignée.
    </aside>

    <a
      href={guideHref}
      class="block rounded border border-cannon-700/50 bg-cannon-950/30 px-4 py-3 text-sm text-iron-200 transition-colors hover:border-cannon-500"
    >
      <span class="font-semibold text-cannon-300">Vous débutez ?</span>
      Le gain le plus rapide vient des touches chiffrées : tapez <kbd class="kbd">8</kbd> une fois pour x1 ou deux fois pour x5, puis cliquez. Un même Silo espace les tirs d’un tick ; plusieurs Silos prêts tirent ensemble. Pour les exercices, lisez le
      <span class="underline decoration-dotted">guide des raccourcis détaillé →</span>
    </a>

    {groups.map((g) => (
      <section id={g.id}>
        <h2 class="text-xl font-semibold text-iron-50 border-b border-iron-800 pb-2 mb-1">{g.label}</h2>
        {g.note && <p class="text-sm text-iron-400 mb-3">{g.note}</p>}
        <table class="w-full text-sm">
          <tbody>
            {g.rows.map((r) => (
              <tr class="border-b border-iron-800/70">
                <td class="py-2 pr-4 w-44 align-top whitespace-nowrap">
                  {r.keys.map((k, i) => (
                    <>
                      {i > 0 && <span class="mx-1 text-iron-600">+</span>}
                      <kbd class="kbd">{k}</kbd>
                    </>
                  ))}
                </td>
                <td class="py-2 text-iron-300 align-top">{r.action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}

    <p class="text-sm text-iron-400">
      Une fois les touches acquises, utilisez le <a class="text-cannon-300 hover:text-cannon-200" href={`${base}/fr/mechanics/economy/`}>guide économique</a> pour choisir quoi construire et la <a class="text-cannon-300 hover:text-cannon-200" href={`${base}/fr/mechanics/nukes/`}>référence nucléaire</a> avant de travailler lancement et interception.
    </p>

    <p class="text-xs text-iron-500">
      Les ajouts v36 complètent les commandes v35. Vérifiez vos réglages enregistrés ; les détails historiques de réassignation gardent leur date de vérification indiquée.
    </p>
  </section>
</BaseLayout>

<style>
  .kbd {
    display: inline-block;
    min-width: 1.4rem;
    text-align: center;
    border: 1px solid rgb(63 63 70 / 0.9);
    border-bottom-width: 2px;
    border-radius: 0.25rem;
    background: rgb(24 24 27 / 0.9);
    padding: 0.05rem 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: rgb(228 228 231);
    line-height: 1.4;
  }
</style>
