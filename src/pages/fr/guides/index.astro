---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CollectionIntro from '../../../components/CollectionIntro.astro';
import GuideCatalog from '../../../components/GuideCatalog.astro';
import { byLang } from '../../../i18n';

const LANG = 'fr';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(LANG))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
---

<BaseLayout title="Tutoriels" description="Tutoriels OpenFront.io du débutant à l'avancé, panneau de commande, raccourcis clavier et analyse de la première partie.">
  <PageHeader eyebrow="GUIDES" title="Tutoriels" lead="De l'ouverture du jeu à votre première expansion réussie, étape par étape." />
  <CollectionIntro kind="guide" />
  <section class="container-wide pt-10" aria-labelledby="quick-answers-title" data-quick-answers>
    <h2 id="quick-answers-title" class="text-2xl font-semibold tracking-tight text-iron-50">Trouver une réponse par situation</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-400">Accédez directement à la décision que vous prenez maintenant, puis parcourez le catalogue complet par thème.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2" data-quick-answer-grid>
  <section class="container-wide pt-8" aria-labelledby="transport-landings-route" data-transport-landings-route>
    <h2 id="transport-landings-route" class="text-lg font-semibold text-iron-50">Vous préparez un débarquement ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Utilisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/transport-landings/`}>guide des débarquements</a> pour choisir une côte accessible, limiter chaque vague, placer l'écran de Warships, établir la tête de pont et annuler l'opération avant qu'elle ne vide votre base.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="mobile-controls-route" data-mobile-controls-route>
    <h2 id="mobile-controls-route" class="text-lg font-semibold text-iron-50">Vous cherchez OpenFront sur mobile ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Vérifiez d’abord <a data-mobile-answer-link class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/mobile-app-download/`}>l’application, le téléchargement et l’APK</a>, puis choisissez <a data-mobile-answer-link class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/mobile-controls/`}>les commandes tactiles</a>, <a data-mobile-answer-link class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/mobile-alternatives/`}>les alternatives en boutique</a> ou <a data-mobile-answer-link class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/mobile-reddit-community/`}>Reddit et la communauté</a> selon votre question.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="tall-vs-wide-route" data-tall-vs-wide-route>
    <h2 id="tall-vs-wide-route" class="text-lg font-semibold text-iron-50">Quand une économie sûre doit-elle prendre plus de terre ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Utilisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/tall-vs-wide/`}>guide tall contre wide</a> pour vérifier liquidité, accès, nécessité et deadline avant de convertir un noyau compact en second point d'appui.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="team-spawn-formation-route" data-team-spawn-formation-route>
    <h2 id="team-spawn-formation-route" class="text-lg font-semibold text-iron-50">Les coéquipiers doivent-ils spawn ensemble ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Utilisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/team-spawn-formation/`}>guide de formation de spawn Team</a> pour lire les anneaux alliés, conserver une lane neutre par joueur et choisir entre un arc connecté et une séparation volontaire.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="overtime-route" data-overtime-route>
    <h2 id="overtime-route" class="text-lg font-semibold text-iron-50">Overtime va-t-il terminer la partie ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Consultez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/winning-overtime/`}>guide victoire et Overtime</a> pour lire le seuil territorial, calculer le prochain palier de 30 secondes et choisir entre défendre l'avance ou l'attaquer.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="water-nukes-route" data-water-nukes-route>
    <h2 id="water-nukes-route" class="text-lg font-semibold text-iron-50">Vous cherchez Water Nukes ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Accédez directement au <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/water-nukes/`}>guide Water Nukes dédié</a> pour la conversion du terrain, les choix d'attaque, la défense et les erreurs courantes.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="warship-veterancy-route" data-warship-veterancy-route>
    <h2 id="warship-veterancy-route" class="text-lg font-semibold text-iron-50">Votre navire gagne des bandes jaunes ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Lisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/warship-veterancy/`}>guide vétéranisation et réparation</a> pour décider entre sortie, escorte, retraite et réparation.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="trade-vs-piracy-route" data-trade-vs-piracy-route>
    <h2 id="trade-vs-piracy-route" class="text-lg font-semibold text-iron-50">Faut-il commercer ou pirater cette route ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Lisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/trade-vs-piracy/`}>guide commerce ou piraterie</a> pour comparer distance, risque de capture, diplomatie et pivot vers les revenus terrestres.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="train-network-route" data-train-network-route>
    <h2 id="train-network-route" class="text-lg font-semibold text-iron-50">Vos trains de Factory rapportent-ils vraiment ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Lisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/train-network/`}>guide du réseau ferroviaire</a> pour la portée, les segments, les arrêts, les hubs et le moment de cesser d'améliorer.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="nuclear-stalemate-breaker-route" data-nuclear-stalemate-breaker-route>
    <h2 id="nuclear-stalemate-breaker-route" class="text-lg font-semibold text-iron-50">Comment briser un blocage nucléaire ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Lisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/nuclear-stalemate-breaker/`}>guide pour briser l'impasse nucléaire</a> afin de choisir entre raid du Silo, blocus du Port ou de la Factory, et objectif terrestre pendant les 90 ticks de recharge.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="team-economy-space-route" data-team-economy-space-route>
    <h2 id="team-economy-space-route" class="text-lg font-semibold text-iron-50">Vos coéquipiers bloquent-ils votre économie ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Utilisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/team-economy-space/`}>guide de l'espace économique Team</a> pour réserver les corridors City, Factory, Port et rail, nommer le payeur, vérifier le premier paiement et arrêter une route qui ne survit plus.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="island-defense-route" data-island-defense-route>
    <h2 id="island-defense-route" class="text-lg font-semibold text-iron-50">Votre côte insulaire va-t-elle être bloquée ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Lisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/island-defense/`}>guide de défense insulaire</a> pour intercepter les transports, placer Port et Defense Post, puis revenir au sol si l'eau est coupée.
    </p>
  </section>
  <section class="container-wide pt-6" aria-labelledby="doomsday-route" data-doomsday-route>
    <h2 id="doomsday-route" class="text-lg font-semibold text-iron-50">Besoin des règles de la Doomsday Clock ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Consultez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/doomsday-clock/`}>guide complet de la Doomsday Clock</a> pour son fonctionnement, toutes les vagues territoriales, l'avertissement, l'attrition, la récupération et les contres.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="threat-assessment-route" data-threat-assessment-route>
    <h2 id="threat-assessment-route" class="text-lg font-semibold text-iron-50">Qui faut-il presser ensuite ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Utilisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/threat-assessment/`}>guide d'evaluation des menaces</a> pour scanner la carte, choisir une cible qui ameliore votre forme et arreter avant de creer un flanc dangereux.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="no-alliances-route" data-no-alliances-route>
    <h2 id="no-alliances-route" class="text-lg font-semibold text-iron-50">Jouer avec les alliances désactivées ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Utilisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/no-alliances-mode/`}>guide sans alliances</a> pour fixer une réserve, réduire les contacts hostiles, préserver le commerce utile et limiter une attaque sans compter sur une trêve.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="defense-posts-route" data-defense-posts-route>
    <h2 id="defense-posts-route" class="text-lg font-semibold text-iron-50">Quand un poste de défense vaut-il son prix ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Consultez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/defense-posts/`}>guide des postes de défense</a> pour placer le rayon de 30 cases, budgéter les 50 ticks et choisir une seconde ligne plutôt qu'un empilement.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="four-islands-team-route" data-four-islands-team-route>
    <h2 id="four-islands-team-route" class="text-lg font-semibold text-iron-50">Comment coordonner une equipe sur Four Islands ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Lisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/four-islands-team-coordination/`}>guide de coordination Four Islands</a> pour repartir les iles, synchroniser les passages, proteger le coeur et transferer une route.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="annexation-enclosure-route" data-annexation-enclosure-route>
    <h2 id="annexation-enclosure-route" class="text-lg font-semibold text-iron-50">Fermer une poche sans surextendre votre front ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Lisez le <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/annexation-enclosure/`}>guide des annexions et de l'encerclement</a> pour tester une petite poussee, verifier la regle du cluster interieur, attribuer le credit et garder une seconde route.
    </p>
  </section>
    </div>
  </section>
  <GuideCatalog guides={all} lang={LANG} />
</BaseLayout>

<style>
  [data-quick-answer-grid] > section { max-width: none; margin: 0; padding: 1.25rem; border: 1px solid rgb(63 63 70 / 0.8); border-radius: 0.5rem; background: rgb(24 24 27 / 0.45); }
</style>
