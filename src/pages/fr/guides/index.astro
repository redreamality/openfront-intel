---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CollectionIntro from '../../../components/CollectionIntro.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const LANG = 'fr';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(LANG))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const fmt = (d: Date) => new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' }).format(d);
const updatedLabel = 'Mis à jour le';
---

<BaseLayout title="Tutoriels" description="Tutoriels OpenFront.io du débutant à l'avancé, panneau de commande, raccourcis clavier et analyse de la première partie.">
  <PageHeader eyebrow="GUIDES" title="Tutoriels" lead="De l'ouverture du jeu à votre première expansion réussie, étape par étape." />
  <CollectionIntro kind="guide" />
  <section class="container-wide pt-8" aria-labelledby="water-nukes-route" data-water-nukes-route>
    <h2 id="water-nukes-route" class="text-lg font-semibold text-iron-50">Vous cherchez Water Nukes ?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Accédez directement au <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}fr/guides/water-nukes/`}>guide Water Nukes dédié</a> pour la conversion du terrain, les choix d'attaque, la défense et les erreurs courantes.
    </p>
  </section>
  <section class="container-wide py-10">
    {all.length === 0 ? (
      <p class="text-iron-400">Aucun tutoriel pour le moment.</p>
    ) : (
      <ul class="space-y-4">
        {all.map((post) => (
          <li>
            <a href={`${base}fr/guides/${stripLangPrefix(post.slug)}/`} class="block card group">
              <div class="flex flex-wrap items-center gap-2 text-xs text-iron-500">
                <span class="tag-chip">{post.data.category ?? 'Tutoriel'}</span>
                {post.data.difficulty && <span class="tag-chip">Difficulté · {post.data.difficulty}</span>}
                <span class="font-mono">{post.data.updatedDate ? `${updatedLabel} ${fmt(post.data.updatedDate)}` : fmt(post.data.pubDate)}</span>
              </div>
              <h2 class="mt-2 text-lg font-semibold text-cannon-400 group-hover:text-cannon-300">{post.data.title}</h2>
              <p class="mt-2 text-sm text-iron-300 leading-relaxed">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
