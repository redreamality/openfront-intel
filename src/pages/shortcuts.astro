---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideHref = `${base}/guides/hotkeys/`;

interface Row { keys: string[]; action: string }
interface Group { id: string; label: string; note?: string; rows: Row[] }

const groups: Group[] = [
  {
    id: 'build',
    label: 'Build & unit number keys',
    note: 'At the same spot, repeat the build key to cycle 1 → 5 → 10 → 15, then by 5 up to 50 and back to 1. This amount applies to existing upgrades and Atom Bombs; new structures, Hydrogen Bombs, and MIRVs stay x1.',
    rows: [
      { keys: ['1'], action: 'Build City' },
      { keys: ['2'], action: 'Build Factory' },
      { keys: ['3'], action: 'Build Port' },
      { keys: ['4'], action: 'Build Defense Post' },
      { keys: ['5'], action: 'Build Missile Silo' },
      { keys: ['6'], action: 'Build SAM Launcher' },
      { keys: ['7'], action: 'Build Warship' },
      { keys: ['8'], action: 'Atom Bomb — stays armed; repeat 8 to increase the batch, limited by Gold and loaded Silo tubes' },
      { keys: ['9'], action: 'Hydrogen Bomb — stays armed for repeat fire' },
      { keys: ['0'], action: 'MIRV' },
      { keys: ['Enter'], action: 'Build the armed unit under the cursor' },
      { keys: ['U'], action: 'Flip the launch arc (up / down) of an armed nuke' },
      { keys: ['Esc'], action: 'Cancel the build preview' },
      { keys: ['H'], action: 'Hold to place a separate structure instead of upgrading a nearby one' },
      { keys: ['Alt', 'Wheel'], action: 'Adjust the armed build amount by 1 within 1–50; does not zoom' },
    ],
  },
  {
    id: 'mouse',
    label: 'Mouse controls',
    note: 'Default scheme. You can swap buttons in Settings → "Left click opens menu".',
    rows: [
      { keys: ['Left-click'], action: 'Attack an enemy / unowned border, or send a transport across water' },
      { keys: ['Left-click'], action: 'Place the armed building on your land' },
      { keys: ['Right-click'], action: 'Cancel an active Warship / boat selection in v33.1; otherwise open the radial / build menu' },
      { keys: ['Ctrl', 'Left-click'], action: 'Open the Build menu at that spot' },
      { keys: ['Alt', 'Left-click'], action: 'Open the emote menu' },
      { keys: ['Shift', 'Drag'], action: 'Box-select multiple warships' },
      { keys: ['Wheel'], action: 'Zoom in / out' },
      { keys: ['Middle-drag'], action: 'Pan the view' },
    ],
  },
  {
    id: 'camera',
    label: 'View & camera',
    note: 'While the emoji menu is open, Q W E A S D select Favorites instead of moving or zooming the camera.',
    rows: [
      { keys: ['Space'], action: 'Alternate view (terrain / countries)' },
      { keys: ['M'], action: 'Toggle the coordinate-grid overlay' },
      { keys: ['C'], action: 'Center the camera on your nation' },
      { keys: ['Q'], action: 'Zoom out' },
      { keys: ['E'], action: 'Zoom in' },
      { keys: ['+', '-'], action: 'Zoom (fallback)' },
      { keys: ['W', 'A', 'S', 'D'], action: 'Pan the camera' },
      { keys: ['P'], action: 'Pause / resume' },
      { keys: [',', '.'], action: 'Game speed down / up (single-player)' },
    ],
  },
  {
    id: 'combat',
    label: 'Combat',
    rows: [
      { keys: ['T'], action: 'Decrease the attack ratio' },
      { keys: ['Y'], action: 'Increase the attack ratio' },
      { keys: ['B'], action: 'Launch a boat (naval) attack toward the target' },
      { keys: ['G'], action: 'Launch a ground attack toward the target' },
      { keys: ['Shift', 'R'], action: 'Retaliate against the player who last attacked you' },
      { keys: ['X'], action: 'Select all of your warships' },
      { keys: ['Shift', 'Drag'], action: 'Select multiple warships' },
    ],
  },
  {
    id: 'diplomacy',
    label: 'Diplomacy',
    rows: [
      { keys: ['F'], action: 'Open / close the emoji menu' },
      { keys: ['R'], action: 'Open quick chat for the player under the cursor' },
      { keys: ['K'], action: 'Request an alliance with the hovered player' },
      { keys: ['L'], action: 'Break an alliance' },
      { keys: ['J'], action: 'Send troops to the ally under the cursor' },
      { keys: ['O'], action: 'Open the send-gold window for the ally under the cursor' },
      { keys: ['I'], action: 'Toggle the player panel for the player under the cursor' },
    ],
  },
  {
    id: 'misc',
    label: 'Misc',
    rows: [
      { keys: ['Esc'], action: 'Close the menu / cancel a build preview' },
      { keys: ['Enter'], action: 'Build the unit under the cursor' },
      { keys: ['Alt', 'R'], action: 'Reset graphics' },
    ],
  },
];
---

<BaseLayout
  title="OpenFront Shortcuts"
  description="OpenFront.io v36 shortcuts: J/O donations, I player panel, H separate builds, build amounts and mouse controls. Check your saved keybindings."
>
  <PageHeader
    eyebrow="SHORTCUTS"
    title="OpenFront Shortcuts"
    lead="This is the default-key lookup reference for OpenFront.io keyboard shortcuts, mouse controls, and build hotkeys, including the v36 additions below. Use the separate Hotkeys guide for battlefield workflows, practice drills, and input recovery. Most action bindings can be remapped in Settings → Keybindings. On macOS, read Ctrl as Cmd."
  />

  <section class="container-wide py-10 space-y-10">
    <p class="border-l-2 border-cannon-500 pl-4 text-sm text-iron-300">
      <strong class="text-iron-100">J/O/I/H and build amounts checked in stable <a href="https://github.com/openfrontio/OpenFrontIO/releases/tag/v0.36.2" class="underline">v0.36.2</a> on November 14, 2026.</strong>
      Repeat the same build key at the same spot for 1 → 5 → 10 → 15, continuing by 5 to 50, then back to 1. Alt+scroll adjusts by 1. Existing upgrades and Atom Bombs use this amount; new structures, Hydrogen Bombs and MIRVs stay x1. Gold and loaded Silo tubes still limit Atom Bomb batches.
      Default labels follow your keyboard layout, including ZQSD on AZERTY. Saved bindings take precedence. The training guide retains its stated v35 scope.
    </p>

    <aside data-keybinding-boundary class="rounded border border-cannon-700/60 bg-cannon-950/20 p-4 text-sm leading-relaxed text-iron-300">
      <strong class="text-cannon-300">v0.35.2 remapping.</strong>
      Settings → Keybindings has dedicated entries for <kbd class="kbd">X</kbd> select-all-warships, the <kbd class="kbd">R</kbd> action in graphics reset (default Alt+R), and <kbd class="kbd">Shift</kbd> + drag warship box selection. Your saved bindings take precedence. The <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/blob/v0.35.2/src/client/UserSettingModal.ts">official v0.35.2 settings</a> expose all three actions.
      The <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/releases/tag/v0.35.0">stable v0.35.0 release</a> moved fleet selection from the old v34 F to X: F now opens emojis and R opens quick chat. If your saved fleet key is F, check the emoji binding too; a conflicting new default can be unbound.
    </aside>

    <a
      href={guideHref}
      class="block rounded border border-cannon-700/50 bg-cannon-950/30 px-4 py-3 text-sm text-iron-200 transition-colors hover:border-cannon-500"
    >
      <span class="font-semibold text-cannon-300">New here?</span>
      The fastest win is the build number keys — tap <kbd class="kbd">8</kbd> once for one Atom Bomb or twice for x5, then left-click. Same-Silo bombs leave one tick apart; separate ready Silos can fire together. For the strategy behind these keys, read the in-depth
      <span class="underline decoration-dotted">Hotkeys guide →</span>
    </a>

    {groups.map((g) => (
      <section id={g.id}>
        <h2 class="text-xl font-semibold text-iron-50 border-b border-iron-800 pb-2 mb-1">{g.label}</h2>
        {g.note && <p class="text-sm text-iron-400 mb-3">{g.note}</p>}
        <table class="w-full text-sm">
          <tbody>
            {g.rows.map((r) => (
              <tr class="border-b border-iron-800/70">
                <td class="py-2 pr-4 w-44 align-top whitespace-nowrap">
                  {r.keys.map((k, i) => (
                    <>
                      {i > 0 && <span class="mx-1 text-iron-600">+</span>}
                      <kbd class="kbd">{k}</kbd>
                    </>
                  ))}
                </td>
                <td class="py-2 text-iron-300 align-top">{r.action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}

    <p class="text-sm text-iron-400">
      Once the layout is familiar, use the <a class="text-cannon-300 hover:text-cannon-200" href={`${base}/mechanics/economy/`}>economy guide</a> to decide what is worth building and the <a class="text-cannon-300 hover:text-cannon-200" href={`${base}/mechanics/nukes/`}>nuclear mechanics reference</a> before practicing launch and interception decisions.
    </p>

    <p class="text-xs text-iron-500">
      The v36 additions above supplement the v35 controls. Check your saved settings before practicing; the historical remapping details retain their stated verification date.
    </p>
  </section>
</BaseLayout>

<style>
  .kbd {
    display: inline-block;
    min-width: 1.4rem;
    text-align: center;
    border: 1px solid rgb(63 63 70 / 0.9);
    border-bottom-width: 2px;
    border-radius: 0.25rem;
    background: rgb(24 24 27 / 0.9);
    padding: 0.05rem 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: rgb(228 228 231);
    line-height: 1.4;
  }
</style>
