---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CollectionIntro from '../../components/CollectionIntro.astro';
import GuideCatalog from '../../components/GuideCatalog.astro';
import { byLang } from '../../i18n';

const LANG = 'en';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(LANG))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
---

<BaseLayout title="Guides" description="OpenFront.io beginner to advanced tutorials, UI walkthrough, and hotkeys.">
  <PageHeader eyebrow="GUIDES" title="Guides" lead="Step-by-step from opening the game to your first successful expansion." />
  <CollectionIntro kind="guide" />
  <section class="container-wide pt-10" aria-labelledby="quick-answers-title" data-quick-answers>
    <h2 id="quick-answers-title" class="text-2xl font-semibold tracking-tight text-iron-50">Find an answer by situation</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-400">Jump straight to the decision you are making right now. These routes stay above the full catalog so urgent questions take one click.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2" data-quick-answer-grid>
  <section class="container-wide pt-8" aria-labelledby="transport-landings-route" data-transport-landings-route>
    <h2 id="transport-landings-route" class="text-lg font-semibold text-iron-50">Planning a landing across open water?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/transport-landings/`}>transport landing guide</a> to choose a reachable coast, cap each wave, place a Warship screen, build a beachhead, and cancel a failing operation before it empties your home front.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="mobile-controls-route" data-mobile-controls-route>
    <h2 id="mobile-controls-route" class="text-lg font-semibold text-iron-50">Looking for OpenFront on mobile?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Check the <a data-mobile-answer-link class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/mobile-app-download/`}>official app, download, and APK answer</a>; then choose <a data-mobile-answer-link class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/mobile-controls/`}>touch controls</a>, <a data-mobile-answer-link class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/mobile-alternatives/`}>store-listed alternatives</a>, or <a data-mobile-answer-link class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/mobile-reddit-community/`}>Reddit and community links</a> by intent.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="tall-vs-wide-route" data-tall-vs-wide-route>
    <h2 id="tall-vs-wide-route" class="text-lg font-semibold text-iron-50">When should a safe economy start taking more land?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/tall-vs-wide/`}>tall versus wide guide</a> to test liquidity, access, need, and deadline before turning a compact core into a second foothold.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="team-spawn-formation-route" data-team-spawn-formation-route>
    <h2 id="team-spawn-formation-route" class="text-lg font-semibold text-iron-50">Should teammates spawn together?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/team-spawn-formation/`}>team spawn formation guide</a> to read teammate rings, preserve one neutral lane per player, and choose between a connected edge arc and a deliberate split.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="overtime-route" data-overtime-route>
    <h2 id="overtime-route" class="text-lg font-semibold text-iron-50">Is Overtime about to end the game?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/winning-overtime/`}>winning and Overtime guide</a> to read the shrinking territory threshold, calculate the next 30-second crossing, and choose whether to defend the lead or attack it.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="water-nukes-route" data-water-nukes-route>
    <h2 id="water-nukes-route" class="text-lg font-semibold text-iron-50">Looking for Water Nukes?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Go straight to the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/water-nukes/`}>dedicated Water Nukes guide</a> for terrain conversion, attack choices, defense, and common mistakes.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="warship-veterancy-route" data-warship-veterancy-route>
    <h2 id="warship-veterancy-route" class="text-lg font-semibold text-iron-50">Is your Warship gaining yellow stripes?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/warship-veterancy/`}>Warship veterancy and repair guide</a> to turn stripes, repair capacity, and retreat thresholds into a safer naval decision.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="trade-vs-piracy-route" data-trade-vs-piracy-route>
    <h2 id="trade-vs-piracy-route" class="text-lg font-semibold text-iron-50">Should you trade or pirate this route?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/trade-vs-piracy/`}>trade versus piracy guide</a> to compare route distance, capture risk, diplomacy, and the right moment to pivot back to land income.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="train-network-route" data-train-network-route>
    <h2 id="train-network-route" class="text-lg font-semibold text-iron-50">Are your Factory trains actually paying?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/train-network/`}>train network guide</a> for station range, rail segment limits, stop payouts, hub layouts, and the safe moment to stop upgrading.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="frontload-investment-route" data-frontload-investment-route>
    <h2 id="frontload-investment-route" class="text-lg font-semibold text-iron-50">When should I buy my first Port or Factory?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/frontload-port-factory-investment/`}>Port and Factory timing guide</a> for how v0.34.12's faster mid-game spawns front-load your extra gold, when a Port pays back in two trade-ship arrivals, and why the Factory waits for the rail network.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="nuclear-stalemate-breaker-route" data-nuclear-stalemate-breaker-route>
    <h2 id="nuclear-stalemate-breaker-route" class="text-lg font-semibold text-iron-50">How do you break a nuclear stalemate?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/nuclear-stalemate-breaker/`}>nuclear stalemate breaker guide</a> to decide whether to raid a Silo, blockade the Port or Factory funding it, or turn a 90-tick reload into a land objective.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="team-economy-space-route" data-team-economy-space-route>
    <h2 id="team-economy-space-route" class="text-lg font-semibold text-iron-50">Are teammates blocking each other's economy?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/team-economy-space/`}>Team economy space guide</a> to reserve City, Factory, Port, and rail corridors, name the payer, prove the first settlement, and stop when a shared route no longer survives.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="island-defense-route" data-island-defense-route>
    <h2 id="island-defense-route" class="text-lg font-semibold text-iron-50">Is your island coast about to be blockaded?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/island-defense/`}>island defense guide</a> to screen transports, place a Port and Defense Post, and know when a disconnected sea route means you should fall back to land.
    </p>
  </section>
  <section class="container-wide pt-6" aria-labelledby="doomsday-route" data-doomsday-route>
    <h2 id="doomsday-route" class="text-lg font-semibold text-iron-50">Need the Doomsday Clock rules?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/doomsday-clock/`}>complete Doomsday Clock guide</a> for what the mode does, every territory-share wave, warning, decay, recovery, and counterplay.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="threat-assessment-route" data-threat-assessment-route>
    <h2 id="threat-assessment-route" class="text-lg font-semibold text-iron-50">Who should you pressure next?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/threat-assessment/`}>threat assessment guide</a> to scan the whole board, choose a target that improves your shape, and stop before a weak neighbor creates a dangerous new flank.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="no-alliances-route" data-no-alliances-route>
    <h2 id="no-alliances-route" class="text-lg font-semibold text-iron-50">Playing with alliances disabled?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/no-alliances-mode/`}>No Alliances guide</a> to set a reserve floor, reduce hostile contacts, preserve useful trade, and time a bounded attack without relying on a ceasefire.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="defense-posts-route" data-defense-posts-route>
    <h2 id="defense-posts-route" class="text-lg font-semibold text-iron-50">When is a Defense Post worth it?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/defense-posts/`}>Defense Posts guide</a> to place the 30-tile defense zone, budget the 50-tick build, and decide when a second line beats stacking one tile.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="four-islands-team-route" data-four-islands-team-route>
    <h2 id="four-islands-team-route" class="text-lg font-semibold text-iron-50">Coordinating a Four Islands team?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/four-islands-team-coordination/`}>Four Islands team coordination guide</a> to assign island jobs, time crossings, protect the shared core, and hand off a route when the map changes.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="annexation-enclosure-route" data-annexation-enclosure-route>
    <h2 id="annexation-enclosure-route" class="text-lg font-semibold text-iron-50">Can you close a pocket without overextending?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/annexation-enclosure/`}>annexation and enclosure guide</a> to use small probes, verify the inland-cluster rule, assign capture credit, and keep a second route after the transfer.
    </p>
  </section>
    </div>
  </section>
  <GuideCatalog guides={all} lang={LANG} />
</BaseLayout>

<style>
  [data-quick-answer-grid] > section {
    max-width: none;
    margin: 0;
    padding: 1.25rem;
    border: 1px solid rgb(63 63 70 / 0.8);
    border-radius: 0.5rem;
    background: rgb(24 24 27 / 0.45);
  }
</style>
