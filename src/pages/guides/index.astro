---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CollectionIntro from '../../components/CollectionIntro.astro';
import { byLang, stripLangPrefix } from '../../i18n';

const LANG = 'en';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(LANG))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const fmt = (d: Date) => new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(d);
const updatedLabel = 'Updated';
---

<BaseLayout title="Guides" description="OpenFront.io beginner to advanced tutorials, UI walkthrough, and hotkeys.">
  <PageHeader eyebrow="GUIDES" title="Guides" lead="Step-by-step from opening the game to your first successful expansion." />
  <CollectionIntro kind="guide" />
  <section class="container-wide pt-8" aria-labelledby="overtime-route" data-overtime-route>
    <h2 id="overtime-route" class="text-lg font-semibold text-iron-50">Is Overtime about to end the game?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/winning-overtime/`}>winning and Overtime guide</a> to read the shrinking territory threshold, calculate the next 30-second crossing, and choose whether to defend the lead or attack it.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="water-nukes-route" data-water-nukes-route>
    <h2 id="water-nukes-route" class="text-lg font-semibold text-iron-50">Looking for Water Nukes?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Go straight to the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/water-nukes/`}>dedicated Water Nukes guide</a> for terrain conversion, attack choices, defense, and common mistakes.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="warship-veterancy-route" data-warship-veterancy-route>
    <h2 id="warship-veterancy-route" class="text-lg font-semibold text-iron-50">Is your Warship gaining yellow stripes?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/warship-veterancy/`}>Warship veterancy and repair guide</a> to turn stripes, repair capacity, and retreat thresholds into a safer naval decision.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="trade-vs-piracy-route" data-trade-vs-piracy-route>
    <h2 id="trade-vs-piracy-route" class="text-lg font-semibold text-iron-50">Should you trade or pirate this route?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/trade-vs-piracy/`}>trade versus piracy guide</a> to compare route distance, capture risk, diplomacy, and the right moment to pivot back to land income.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="train-network-route" data-train-network-route>
    <h2 id="train-network-route" class="text-lg font-semibold text-iron-50">Are your Factory trains actually paying?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/train-network/`}>train network guide</a> for station range, rail segment limits, stop payouts, hub layouts, and the safe moment to stop upgrading.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="island-defense-route" data-island-defense-route>
    <h2 id="island-defense-route" class="text-lg font-semibold text-iron-50">Is your island coast about to be blockaded?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Read the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/island-defense/`}>island defense guide</a> to screen transports, place a Port and Defense Post, and know when a disconnected sea route means you should fall back to land.
    </p>
  </section>
  <section class="container-wide pt-6" aria-labelledby="doomsday-route" data-doomsday-route>
    <h2 id="doomsday-route" class="text-lg font-semibold text-iron-50">Need the Doomsday Clock rules?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/doomsday-clock/`}>complete Doomsday Clock guide</a> for what the mode does, every territory-share wave, warning, decay, recovery, and counterplay.
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="threat-assessment-route" data-threat-assessment-route>
    <h2 id="threat-assessment-route" class="text-lg font-semibold text-iron-50">Who should you pressure next?</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      Use the <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}guides/threat-assessment/`}>threat assessment guide</a> to scan the whole board, choose a target that improves your shape, and stop before a weak neighbor creates a dangerous new flank.
    </p>
  </section>
  <section class="container-wide py-10">
    {all.length === 0 ? (
      <p class="text-iron-400">No guides yet.</p>
    ) : (
      <ul class="space-y-4">
        {all.map((post) => (
          <li>
            <a href={`${base}guides/${stripLangPrefix(post.slug)}/`} class="block card group">
              <div class="flex flex-wrap items-center gap-2 text-xs text-iron-500">
                <span class="tag-chip">{post.data.category ?? 'Guide'}</span>
                {post.data.difficulty && <span class="tag-chip">Difficulty · {post.data.difficulty}</span>}
                <span class="font-mono">{post.data.updatedDate ? `${updatedLabel} ${fmt(post.data.updatedDate)}` : fmt(post.data.pubDate)}</span>
              </div>
              <h2 class="mt-2 text-lg font-semibold text-cannon-400 group-hover:text-cannon-300">{post.data.title}</h2>
              <p class="mt-2 text-sm text-iron-300 leading-relaxed">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
