---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CollectionIntro from '../../../components/CollectionIntro.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const LANG = 'zh';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(LANG))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const fmt = (d: Date) => new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' }).format(d);
const updatedLabel = '更新于';
---

<BaseLayout title="教程" description="OpenFront.io 新手到进阶教程，操作面板、快捷键与第一局复盘。">
  <PageHeader eyebrow="GUIDES" title="教程" lead="从打开游戏到第一次成功扩张，一步一步走。" />
  <CollectionIntro kind="guide" />
  <section class="container-wide pt-8" aria-labelledby="overtime-route" data-overtime-route>
    <h2 id="overtime-route" class="text-lg font-semibold text-iron-50">Overtime 即将结束对局？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      阅读 <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/winning-overtime/`}>胜利门槛与 Overtime 攻略</a>，看懂下降中的领土门槛，计算下一次 30 秒越线点，并判断应该守住领先还是攻击第一名。
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="water-nukes-route" data-water-nukes-route>
    <h2 id="water-nukes-route" class="text-lg font-semibold text-iron-50">在找 Water Nukes（水核弹）？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      直接阅读 <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/water-nukes/`}>Water Nukes 专项攻略</a>，查看地形转换、进攻选择、防守和常见错误。
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="warship-veterancy-route" data-warship-veterancy-route>
    <h2 id="warship-veterancy-route" class="text-lg font-semibold text-iron-50">战舰出现黄色条纹了？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      阅读 <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/warship-veterancy/`}>战舰经验与维修攻略</a>，把条纹、港口维修容量和返航阈值转化为更安全的海军决策。
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="trade-vs-piracy-route" data-trade-vs-piracy-route>
    <h2 id="trade-vs-piracy-route" class="text-lg font-semibold text-iron-50">这条航线该贸易还是海盗？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      阅读<a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/trade-vs-piracy/`}>贸易与海盗攻略</a>，比较航线距离、捕获风险、外交开关，以及何时转回陆地收入。
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="train-network-route" data-train-network-route>
    <h2 id="train-network-route" class="text-lg font-semibold text-iron-50">Factory 列车真的在赚钱吗？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      阅读<a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/train-network/`}>铁路网络攻略</a>，了解车站范围、路段上限、停站收益、枢纽布局，以及何时停止升级。
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="island-defense-route" data-island-defense-route>
    <h2 id="island-defense-route" class="text-lg font-semibold text-iron-50">你的岛屿海岸要被封锁了吗？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      阅读<a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/island-defense/`}>岛屿防守攻略</a>，学会屏护运输船、放置港口与防御工事，并在水路断开时及时转回陆地。
    </p>
  </section>
  <section class="container-wide pt-6" aria-labelledby="doomsday-route" data-doomsday-route>
    <h2 id="doomsday-route" class="text-lg font-semibold text-iron-50">想了解末日时钟规则？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      直接阅读 <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/doomsday-clock/`}>末日时钟完整攻略</a>，查看模式作用、全部领土波次、警告、损耗、恢复与反制。
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="threat-assessment-route" data-threat-assessment-route>
    <h2 id="threat-assessment-route" class="text-lg font-semibold text-iron-50">下一个该压谁？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      用<a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/threat-assessment/`}>威胁评估攻略</a>扫描全图，选择能改善局面形状的目标，并在弱邻居变成危险侧翼前停止扩张。
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="defense-posts-route" data-defense-posts-route>
    <h2 id="defense-posts-route" class="text-lg font-semibold text-iron-50">防御柱什么时候值得建？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      阅读<a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/defense-posts/`}>防御柱攻略</a>，学习 30 格范围、50 ticks 施工预算，以及第二道防线何时优于同点堆叠。
    </p>
  </section>
  <section class="container-wide py-10">
    {all.length === 0 ? (
      <p class="text-iron-400">暂无教程。</p>
    ) : (
      <ul class="space-y-4">
        {all.map((post) => (
          <li>
            <a href={`${base}zh/guides/${stripLangPrefix(post.slug)}/`} class="block card group">
              <div class="flex flex-wrap items-center gap-2 text-xs text-iron-500">
                <span class="tag-chip">{post.data.category ?? '教程'}</span>
                {post.data.difficulty && <span class="tag-chip">难度 · {post.data.difficulty}</span>}
                <span class="font-mono">{post.data.updatedDate ? `${updatedLabel} ${fmt(post.data.updatedDate)}` : fmt(post.data.pubDate)}</span>
              </div>
              <h2 class="mt-2 text-lg font-semibold text-cannon-400 group-hover:text-cannon-300">{post.data.title}</h2>
              <p class="mt-2 text-sm text-iron-300 leading-relaxed">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
