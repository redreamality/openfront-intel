---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CollectionIntro from '../../../components/CollectionIntro.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const LANG = 'zh';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('guides', ({ data }) => !data.draft))
  .filter(byLang(LANG))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const fmt = (d: Date) => new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' }).format(d);
const updatedLabel = '更新于';
---

<BaseLayout title="教程" description="OpenFront.io 新手到进阶教程，操作面板、快捷键与第一局复盘。">
  <PageHeader eyebrow="GUIDES" title="教程" lead="从打开游戏到第一次成功扩张，一步一步走。" />
  <CollectionIntro kind="guide" />
  <section class="container-wide pt-8" aria-labelledby="overtime-route" data-overtime-route>
    <h2 id="overtime-route" class="text-lg font-semibold text-iron-50">Overtime 即将结束对局？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      阅读 <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/winning-overtime/`}>胜利门槛与 Overtime 攻略</a>，看懂下降中的领土门槛，计算下一次 30 秒越线点，并判断应该守住领先还是攻击第一名。
    </p>
  </section>
  <section class="container-wide pt-8" aria-labelledby="water-nukes-route" data-water-nukes-route>
    <h2 id="water-nukes-route" class="text-lg font-semibold text-iron-50">在找 Water Nukes（水核弹）？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      直接阅读 <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/water-nukes/`}>Water Nukes 专项攻略</a>，查看地形转换、进攻选择、防守和常见错误。
    </p>
  </section>
  <section class="container-wide pt-6" aria-labelledby="doomsday-route" data-doomsday-route>
    <h2 id="doomsday-route" class="text-lg font-semibold text-iron-50">想了解末日时钟规则？</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-iron-300">
      直接阅读 <a class="text-cannon-400 hover:text-cannon-300 underline" href={`${base}zh/guides/doomsday-clock/`}>末日时钟完整攻略</a>，查看模式作用、全部领土波次、警告、损耗、恢复与反制。
    </p>
  </section>
  <section class="container-wide py-10">
    {all.length === 0 ? (
      <p class="text-iron-400">暂无教程。</p>
    ) : (
      <ul class="space-y-4">
        {all.map((post) => (
          <li>
            <a href={`${base}zh/guides/${stripLangPrefix(post.slug)}/`} class="block card group">
              <div class="flex flex-wrap items-center gap-2 text-xs text-iron-500">
                <span class="tag-chip">{post.data.category ?? '教程'}</span>
                {post.data.difficulty && <span class="tag-chip">难度 · {post.data.difficulty}</span>}
                <span class="font-mono">{post.data.updatedDate ? `${updatedLabel} ${fmt(post.data.updatedDate)}` : fmt(post.data.pubDate)}</span>
              </div>
              <h2 class="mt-2 text-lg font-semibold text-cannon-400 group-hover:text-cannon-300">{post.data.title}</h2>
              <p class="mt-2 text-sm text-iron-300 leading-relaxed">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
