---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { byLang, stripLangPrefix } from '../../../i18n';

const base = import.meta.env.BASE_URL;
const maps = (await getCollection('maps', ({ data }) => !data.draft))
  .filter(byLang('zh'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'));
---

<BaseLayout title="OpenFront 地图攻略" description="逐张地图核验地形、出生、路线、Compact 差异与反制。">
  <PageHeader eyebrow="地图" title="地图攻略" lead="选择一张地图，查看可复核地形数据、出生问题、路线判断、Compact 差异和反制方案。" />
  <section class="container-wide py-10" aria-labelledby="map-list">
    <h2 id="map-list" class="sr-only">地图攻略列表</h2>
    <ul class="grid gap-4 md:grid-cols-2">
      {maps.map((map) => (
        <li>
          <a href={`${base}zh/maps/${stripLangPrefix(map.slug)}/`} class="block card group h-full">
            <span class="tag-chip">{map.data.category ?? '地图攻略'}</span>
            <h2 class="mt-3 text-xl font-semibold text-cannon-400 group-hover:text-cannon-300">{map.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-iron-300">{map.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
