---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideHref = `${base}/zh/guides/hotkeys/`;

interface Row { keys: string[]; action: string }
interface Group { id: string; label: string; note?: string; rows: Row[] }

const groups: Group[] = [
  {
    id: 'build',
    label: '建造 / 单位数字键',
    note: '在同一位置重复按建造键，数量按 1 → 5 → 10 → 15 循环，随后每次加 5，达到 50 后回到 1。数量用于已有建筑升级和原子弹；新建建筑、氢弹与 MIRV 仍是 x1。',
    rows: [
      { keys: ['1'], action: '建造城市 City' },
      { keys: ['2'], action: '建造工厂 Factory' },
      { keys: ['3'], action: '建造港口 Port' },
      { keys: ['4'], action: '建造防御工事 Defense Post' },
      { keys: ['5'], action: '建造导弹井 Missile Silo' },
      { keys: ['6'], action: '建造 SAM 发射器' },
      { keys: ['7'], action: '建造战舰 Warship' },
      { keys: ['8'], action: '原子弹 —— 发射后保持武装；重复按 8 增加批量，受金币与已装填发射管限制' },
      { keys: ['9'], action: '氢弹 —— 发射后仍挂在光标上，可连点连发' },
      { keys: ['0'], action: 'MIRV 多弹头' },
      { keys: ['Enter'], action: '在光标处建造已装填的单位' },
      { keys: ['U'], action: '翻转已装填核弹的发射弧线（向上 / 向下）' },
      { keys: ['Esc'], action: '取消建造预览' },
      { keys: ['H'], action: '按住后新建独立建筑，避免升级附近已有建筑' },
      { keys: ['Alt', '滚轮'], action: '将已选建造数量逐个增减，范围 1–50；此时不缩放地图' },
    ],
  },
  {
    id: 'mouse',
    label: '鼠标操作',
    note: '默认方案。可在 设置 →「左键打开菜单」中互换左右键。',
    rows: [
      { keys: ['左键'], action: '攻击敌方 / 无主边界，或跨水域自动发运输船' },
      { keys: ['左键'], action: '在自己领土放下已装填的建筑' },
      { keys: ['右键'], action: 'v33.1 中先取消当前战舰 / 船只选择；没有选择时打开环形 / 建造菜单' },
      { keys: ['Ctrl', '左键'], action: '在该点打开建造菜单' },
      { keys: ['Alt', '左键'], action: '打开表情菜单' },
      { keys: ['Shift', '拖拽'], action: '框选多艘战舰' },
      { keys: ['滚轮'], action: '缩放' },
      { keys: ['中键拖拽'], action: '平移视角' },
    ],
  },
  {
    id: 'camera',
    label: '视角 / 镜头',
    note: '表情菜单打开时，Q W E A S D 用于收藏表情，不再平移或缩放镜头。',
    rows: [
      { keys: ['Space'], action: '切换视图（地形 / 国家）' },
      { keys: ['M'], action: '开关坐标网格叠加层' },
      { keys: ['C'], action: '镜头居中到自己的国家' },
      { keys: ['Q'], action: '缩小' },
      { keys: ['E'], action: '放大' },
      { keys: ['+', '-'], action: '缩放（备用键）' },
      { keys: ['W', 'A', 'S', 'D'], action: '平移镜头' },
      { keys: ['P'], action: '暂停 / 继续' },
      { keys: [',', '.'], action: '游戏减速 / 加速（单人）' },
    ],
  },
  {
    id: 'combat',
    label: '战斗',
    rows: [
      { keys: ['T'], action: '降低攻击比例' },
      { keys: ['Y'], action: '提高攻击比例' },
      { keys: ['B'], action: '向目标发起海上（船）攻击' },
      { keys: ['G'], action: '向目标发起地面攻击' },
      { keys: ['Shift', 'R'], action: '反击最近一次攻击你的玩家' },
      { keys: ['X'], action: '选中你所有的战舰' },
      { keys: ['Shift', '拖拽'], action: '框选多艘战舰' },
    ],
  },
  {
    id: 'diplomacy',
    label: '外交',
    rows: [
      { keys: ['F'], action: '打开或关闭表情菜单' },
      { keys: ['R'], action: '为光标下的玩家打开快捷聊天' },
      { keys: ['K'], action: '向悬停的玩家请求结盟' },
      { keys: ['L'], action: '解除同盟' },
      { keys: ['J'], action: '向光标下的盟友发送兵力' },
      { keys: ['O'], action: '为光标下的盟友打开发送金币窗口' },
      { keys: ['I'], action: '切换光标下玩家的信息面板' },
    ],
  },
  {
    id: 'misc',
    label: '杂项',
    rows: [
      { keys: ['Esc'], action: '关闭菜单 / 取消建造预览' },
      { keys: ['Enter'], action: '在光标处建造单位' },
      { keys: ['Alt', 'R'], action: '重置图形' },
    ],
  },
];
---

<BaseLayout
  title="OpenFront 快捷键"
  description="OpenFront.io v36 默认键位速查表：J/O 捐兵与金币，I 玩家面板，H 独立建造，批量数量循环和鼠标操作；实际以保存的绑定为准。"
>
  <PageHeader
    eyebrow="SHORTCUTS"
    title="OpenFront 快捷键"
    lead="本页是 OpenFront.io 默认键位的速查表，按用途列出键盘快捷键、鼠标操作与建造热键，并补充下方 v36 新操作。需要战场流程、练习步骤和输入恢复时，请转到独立的快捷键教程。大多数动作键可在 设置 → 键位绑定 中重映射。macOS 上把 Ctrl 看作 Cmd。"
  />

  <section class="container-wide py-10 space-y-10">
    <p class="border-l-2 border-cannon-500 pl-4 text-sm text-iron-300">
      <strong class="text-iron-100">J/O/I/H 与建造数量已于 2026 年 11 月 14 日按正式 <a href="https://github.com/openfrontio/OpenFrontIO/releases/tag/v0.36.2" class="underline">v0.36.2</a> 核验。</strong>
      在同一位置重复按建造键，数量为 1 → 5 → 10 → 15，随后每次加 5，达到 50 后回到 1。Alt+滚轮逐个增减。已有建筑升级和原子弹使用该数量；新建建筑、氢弹与 MIRV 仍为 x1。原子弹批量仍受金币和已装填发射管限制。
      默认键位提示跟随键盘布局，例如 AZERTY 的 ZQSD；保存的绑定优先。训练教程保留其标注的 v35 范围。
    </p>

    <aside data-keybinding-boundary class="rounded border border-cannon-700/60 bg-cannon-950/20 p-4 text-sm leading-relaxed text-iron-300">
      <strong class="text-cannon-300">v0.35.2 重映射。</strong>
      设置 → 键位绑定 已为 <kbd class="kbd">X</kbd> 全选战舰、图形重置中的 <kbd class="kbd">R</kbd>（默认 Alt+R），以及 <kbd class="kbd">Shift</kbd> + 拖动框选战舰提供独立条目。实际操作以你保存的绑定为准。<a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/blob/v0.35.2/src/client/UserSettingModal.ts">官方 v0.35.2 设置</a>包含这三个动作。
      <a class="text-cannon-300 hover:text-cannon-200" href="https://github.com/openfrontio/OpenFrontIO/releases/tag/v0.35.0">正式 v0.35.0 版本说明</a>已将全选战舰从 v34 的 F 改为 X：F 打开表情，R 打开快捷聊天。若保存的舰队键仍是 F，也要检查表情绑定；冲突的新默认动作可能被解绑。
    </aside>

    <a
      href={guideHref}
      class="block rounded border border-cannon-700/50 bg-cannon-950/30 px-4 py-3 text-sm text-iron-200 transition-colors hover:border-cannon-500"
    >
      <span class="font-semibold text-cannon-300">刚上手？</span>
      最快见效的是建造数字键 —— 按一次 <kbd class="kbd">8</kbd> 发 1 枚，连按两次选择 x5，再左键点目标。同一 Silo 逐 tick 发射，不同可用 Silo 可以并发。想练习核弹齐射与故障恢复，请读深入的
      <span class="underline decoration-dotted">热键教程 →</span>
    </a>

    {groups.map((g) => (
      <section id={g.id}>
        <h2 class="text-xl font-semibold text-iron-50 border-b border-iron-800 pb-2 mb-1">{g.label}</h2>
        {g.note && <p class="text-sm text-iron-400 mb-3">{g.note}</p>}
        <table class="w-full text-sm">
          <tbody>
            {g.rows.map((r) => (
              <tr class="border-b border-iron-800/70">
                <td class="py-2 pr-4 w-44 align-top whitespace-nowrap">
                  {r.keys.map((k, i) => (
                    <>
                      {i > 0 && <span class="mx-1 text-iron-600">+</span>}
                      <kbd class="kbd">{k}</kbd>
                    </>
                  ))}
                </td>
                <td class="py-2 text-iron-300 align-top">{r.action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}

    <p class="text-sm text-iron-400">
      熟悉键位后，用<a class="text-cannon-300 hover:text-cannon-200" href={`${base}/zh/mechanics/economy/`}>经济攻略</a>判断什么值得建造，再用<a class="text-cannon-300 hover:text-cannon-200" href={`${base}/zh/mechanics/nukes/`}>核武器机制页</a>核对发射与拦截决策。
    </p>

    <p class="text-xs text-iron-500">
      上方 v36 新操作补充原 v35 键位；练习前先检查保存的设置。历史改键说明保留其标注的核验日期。
    </p>
  </section>
</BaseLayout>

<style>
  .kbd {
    display: inline-block;
    min-width: 1.4rem;
    text-align: center;
    border: 1px solid rgb(63 63 70 / 0.9);
    border-bottom-width: 2px;
    border-radius: 0.25rem;
    background: rgb(24 24 27 / 0.9);
    padding: 0.05rem 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: rgb(228 228 231);
    line-height: 1.4;
  }
</style>
